#!/bin/bash
# gtg-nudge -- grease-the-groove reminder. Run by launchd at :20 and :50 past the hour.
# Exits 0 quietly whenever it should not interrupt. See README.md for the full rules.
set -u

. "$(dirname "$0")/gtg-lib.sh"

# DEBOUNCE_SECS lives in gtg-lib.sh: `gtg nudges` has to work out when the next
# nudge is possible, and a second copy of the number here is a second copy that
# can drift.
#
# How far ahead a meeting still counts as "starting soon".
SOON_MINS=12

# Keyboard and mouse idle, in seconds. HID only: an unlocked laptop with
# agents running and nobody touching it still reads idle. GTG_IDLE_CMD stubs
# the command in tests; it is a shell command, not just a program name.
read_idle() {
  local out
  if [ -n "${GTG_IDLE_CMD:-}" ]; then
    out=$(bash -c "$GTG_IDLE_CMD" 2>/dev/null || true)
  else
    out=$(ioreg -c IOHIDSystem 2>/dev/null \
          | awk '/HIDIdleTime/ {print int($NF/1000000000); exit}')
  fi
  printf '%s' "$out" | tr -cd '0-9'
}

# One POST /api/route. ROUTE_TRY_RC is 0 with ROUTE_TRY set, 1 when the reply
# was lost or unreadable, 2 when there is no token (that one is not retried).
route_try() {
  local url="$1" json="$2" rc=0 resp route
  ROUTE_TRY=""
  ROUTE_TRY_RC=1
  ROUTE_SLOT=""
  resp=$(hub_http_post "${url%/}/api/route" "$json") || rc=$?
  if [ "$rc" -eq 2 ]; then
    ROUTE_TRY_RC=2
    return 0
  fi
  if [ "$rc" -ne 0 ] || [ -z "$resp" ]; then
    return 0
  fi
  route=$(printf '%s' "$resp" | /usr/bin/python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("route") or "")
except Exception:
    print("")')
  ROUTE_SLOT=$(printf '%s' "$resp" | /usr/bin/python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("slot") or "")
except Exception:
    print("")')
  case "$route" in
    laptop|phone|handoff|skip:*)
      ROUTE_TRY=$route
      ROUTE_TRY_RC=0
      ;;
    *)
      ROUTE_SLOT=""
      ;;
  esac
}

# Ask the hub which device owns this hour. Sets ROUTE_RESULT and ROUTE_SLOT.
# phone / skip:* / handoff are noted here; the caller exits without stamping,
# the same way a fire that shows nothing already does.
#
# HTTP, not ssh. ssh would be a second writer of slots.tsv. The server is the
# only writer, and it holds its lock across the claim and the webhook.
route_ask() {
  ROUTE_RESULT=""
  ROUTE_SLOT=""
  local url token idle meet json
  url=$(cfg HUB_URL)
  if [ -z "$url" ]; then
    note "ERROR: HUB is set and HUB_URL is not; showing the dialog"
    ROUTE_RESULT=unreachable
    return 0
  fi
  token="$CONF_DIR/token"
  if [ ! -s "$token" ]; then
    note "ERROR: no token at $token; one-time: ssh $(cfg HUB) 'cat ~/.config/gtg/token' > ~/.config/gtg/token && chmod 600 ~/.config/gtg/token"
    ROUTE_RESULT=unreachable
    return 0
  fi
  idle=$(read_idle)
  case "$idle" in
    ''|*[!0-9]*)
      note "idle unreadable, assuming present"
      idle=0 ;;
  esac
  meet=false
  [ "${busy_now:-no}" = yes ] && meet=true
  json=$(ROUTE_IDLE="$idle" ROUTE_MEETING="$meet" ROUTE_WHERE="$route_where" /usr/bin/python3 -c 'import json,os
body={"device":"laptop","idle":int(os.environ["ROUTE_IDLE"]),"meeting":os.environ["ROUTE_MEETING"]=="true"}
if os.environ["ROUTE_WHERE"]:
    body["where"]=os.environ["ROUTE_WHERE"]
print(json.dumps(body))')
  route_try "$url" "$json"
  # ponytail: retry the same POST once. Routing is idempotent per slot, so
  # the second call returns the owner and sends nothing. Residual: both
  # attempts lost after a send still double-pings. Ceiling: two lost replies.
  # Upgrade: read the slot's owner before failing open.
  if [ "$ROUTE_TRY_RC" -eq 1 ]; then
    route_try "$url" "$json"
  fi
  if [ "$ROUTE_TRY_RC" -ne 0 ] || [ -z "$ROUTE_TRY" ]; then
    note "routed: hub unreachable, showing the dialog"
    ROUTE_RESULT=unreachable
    return 0
  fi
  case "$ROUTE_TRY" in
    laptop) ROUTE_RESULT=laptop ;;
    phone)  note "routed: phone"; ROUTE_RESULT=phone ;;
    skip:*) note "routed: skip (${ROUTE_TRY#skip:})"; ROUTE_RESULT=$ROUTE_TRY ;;
    handoff) note "routed: handoff"; ROUTE_RESULT=handoff ;;
    *)
      note "routed: hub unreachable, showing the dialog"
      ROUTE_RESULT=unreachable ;;
  esac
}

# The dialog gave up. Phone the hour only when nothing was touched since it
# opened and the hub still has this machine as the owner. Unreadable idle
# does nothing: guessing "away" would ping the phone for a sensor failure.
# `maybe_handoff force` skips that idle read. It is the failed-display path:
# nothing was shown, so recent input is not an answer. The hub still refuses
# unless this machine owns the hour and no set was logged since.
maybe_handoff() {
  [ -n "$(cfg HUB)" ] || return 0
  local idle elapsed now_s url meet json resp rc route
  if [ "${1:-}" != force ]; then
    idle=$(read_idle)
    case "$idle" in ''|*[!0-9]*) return 0 ;; esac
    now_s=$(date +%s)
    elapsed=$(( now_s - ${DIALOG_OPENED:-now_s} ))
    [ "$idle" -ge "$elapsed" ] || return 0
  fi
  url=$(cfg HUB_URL)
  [ -n "$url" ] || return 0
  [ -s "$CONF_DIR/token" ] || return 0
  meet=false
  [ "${busy_now:-no}" = yes ] && meet=true
  json=$(ROUTE_MEETING="$meet" ROUTE_SLOT="${ROUTE_SLOT:-}" ROUTE_WHERE="$route_where" /usr/bin/python3 -c 'import json,os
body={"meeting":os.environ["ROUTE_MEETING"]=="true"}
if os.environ["ROUTE_WHERE"]:
    body["where"]=os.environ["ROUTE_WHERE"]
slot=os.environ.get("ROUTE_SLOT","")
if slot:
    body["slot"]=slot
print(json.dumps(body))')
  rc=0
  resp=$(hub_http_post "${url%/}/api/route/handoff" "$json") || rc=$?
  if [ "$rc" -ne 0 ] || [ -z "$resp" ]; then
    note "routed: handoff failed (hub unreachable)"
    return 0
  fi
  route=$(printf '%s' "$resp" | /usr/bin/python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("route") or "")
except Exception:
    print("")')
  case "$route" in
    handoff) note "routed: handoff" ;;
    phone)   note "routed: phone" ;;
    skip:*)  note "routed: skip (${route#skip:})" ;;
    laptop|none) ;;
    *) note "routed: handoff failed (hub unreachable)" ;;
  esac
}

# Best effort. A missed "answered" row must not fail a nudge that already
# logged the set. how is log, skip, snooze, or off.
route_answered() {
  [ -n "$(cfg HUB)" ] || return 0
  local how="$1" url json resp rc
  url=$(cfg HUB_URL)
  [ -n "$url" ] || return 0
  [ -s "$CONF_DIR/token" ] || return 0
  json=$(ANSWER_HOW="$how" ROUTE_SLOT="${ROUTE_SLOT:-}" /usr/bin/python3 -c 'import json,os
body={"how":os.environ["ANSWER_HOW"]}
slot=os.environ.get("ROUTE_SLOT","")
if slot:
    body["slot"]=slot
print(json.dumps(body))')
  rc=0
  resp=$(hub_http_post "${url%/}/api/route/answered" "$json") || rc=$?
  if [ "$rc" -ne 0 ] || [ -z "$resp" ]; then
    note "routed: answered not recorded (hub unreachable)"
  fi
}

# Presses Snooze on our own alert, found by its three buttons. Pressing a
# button, not killing osascript: System Events owns the window, and a killed
# osascript leaves it on screen with nothing to collect it (see osa below).
# Hammerspoon because it already holds the Accessibility grant.
DISMISS_LUA='
local app = hs.application.get("com.apple.systemevents")
if not app then return "0" end
local function find(el, depth, want)
  if depth > 4 then return nil end
  for _, c in ipairs(el:attributeValue("AXChildren") or {}) do
    if c:attributeValue("AXRole") == "AXButton" and c:attributeValue("AXTitle") == want then return c end
    local hit = find(c, depth + 1, want)
    if hit then return hit end
  end
  return nil
end
local n = 0
for _, w in ipairs(hs.axuielement.applicationElement(app):attributeValue("AXWindows") or {}) do
  local snooze = find(w, 0, "Snooze")
  if snooze and find(w, 0, "Did it") and find(w, 0, "Other...") then
    snooze:performAction("AXPress")
    n = n + 1
  end
end
return tostring(n)'

dismiss_dialog() {
  if [ -n "${GTG_DISMISS_CMD:-}" ]; then
    bash -c "$GTG_DISMISS_CMD" 2>/dev/null
    return
  fi
  [ -n "${HS:-}" ] || { printf '0'; return; }
  "$HS" -t 5 -c "$DISMISS_LUA" 2>/dev/null | tail -1
}

# Runs beside the dialog. A set logged anywhere else since the hub gave this
# machine the hour -- the bot, the CLI, the phone -- takes the dialog down.
# Leaves the set in $ELSEWHERE so the main script knows the Snooze was ours.
watch_elsewhere() {
  local url pid resp got pressed
  url=$(cfg HUB_URL)
  while :; do
    sleep "${GTG_ELSEWHERE_POLL:-20}"
    pid=$(cat "$DIALOG_PID" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    kill -0 "$pid" 2>/dev/null || return 0
    resp=$(hub_http_post "${url%/}/api/route/status" "{\"slot\":\"$ROUTE_SLOT\"}") || continue
    got=$(printf '%s' "$resp" | /usr/bin/python3 -c 'import json,sys
try:
    b=json.load(sys.stdin)
except Exception:
    b={}
if b.get("logged") is True:
    print(b.get("what") or "a set")')
    [ -n "$got" ] || continue
    printf '%s' "$got" >"$ELSEWHERE"
    pressed=$(dismiss_dialog)
    [ "${pressed:-0}" != 0 ] || note "logged elsewhere ($got), but the dialog could not be closed"
    return 0
  done
}

# note() lives in gtg-lib.sh: `gtg note` writes the same shape of line.

[ -r "$PLAN" ] || { note "FATAL: no plan file at $PLAN"; exit 1; }

now=$(date +%s)

# Every path out of this script says why, including the ones that do nothing.
#
# These two checks used to exit silently, and they are the two that fire most
# often -- so "did I miss a nudge five minutes ago?" had no answer in the log.
# An absent line is indistinguishable from a job that never ran, which is the
# same ambiguity that once hid twelve broken dialogs for two days. A skip is
# not nothing happening; it is a decision, and it gets recorded like one.
#
# Roughly 48 lines a day, most of them overnight. `gtg nudges` reads them back.

# --- 1. debounce ------------------------------------------------------------
last=$(cat "$STAMP" 2>/dev/null || echo 0)
case "$last" in ''|*[!0-9]*) last=0 ;; esac
if [ $(( now - last )) -lt "$DEBOUNCE_SECS" ]; then
  note "skip: debounced, $(( (now - last) / 60 )) min since the last nudge (needs $(( DEBOUNCE_SECS / 60 ))); next due $(date -r $(( last + DEBOUNCE_SECS )) '+%H:%M')"
  exit 0
fi

# --- 2. waking window -------------------------------------------------------
if ! in_waking_window "$(date +%-H)"; then
  note "skip: outside waking hours (${WAKE_S}:00 until ${WAKE_E}:00)"
  exit 0
fi

# --- 3. turned off on purpose -----------------------------------------------
# A sick day, or any day the answer is already no. Said out loud, with an end
# time, and it expires by itself -- see pause_active in gtg-lib.sh. The line
# is logged like every other decision, and `gtg fires` counts these apart from
# the nudges that were ignored: a quiet day chosen is not a day of refusals.
#
# The pause file is the hub's when HUB= is set. Pull before reading it, or a
# pause made on the mini is invisible and this fire talks over it. Same pull
# refreshes the log before today's options are chosen.
if [ -n "$(cfg HUB)" ]; then
  hub_pull || true
fi
if pause_active; then
  note "skip: paused until $(pause_human "$PAUSE_UNTIL")${PAUSE_WHY:+ ($PAUSE_WHY)}"
  exit 0
fi

# --- 4. home vs away --------------------------------------------------------
gateway=$(current_gateway_mac || true)
where=$(where_am_i "$gateway")
# The hub sends an away hour to the phone even at the keyboard, so it only
# hears a location this machine actually read. No gateway, or no home list,
# is unknown rather than away: the idle rule decides instead.
route_where=$where
if [ -z "$gateway" ] || [ ! -s "$HOME_MAC_FILE" ]; then
  route_where=""
fi

# --- 5. meeting check -------------------------------------------------------
# FAILS OPEN on purpose: a missing icalBuddy, a refused calendar grant, a bad
# calendar name, or any error at all still nudges. A stray banner during a
# meeting is a much cheaper failure than a reminder system that quietly stops.
#
# -ea excludes all-day events. That matters more than it looks: a single "PTO"
# entry, a birthday, or a subscribed holiday would otherwise read as an
# all-day meeting and silently mute the entire day.
busy_now=no
starts_soon=no
if [ -n "${GTG_ICAL+x}" ]; then
  ical=$GTG_ICAL
else
  ical=$(command -v icalBuddy 2>/dev/null || true)
fi
if [ -n "$ical" ]; then
  args=(-nc -nrd -ea -b "" -iep "title,attendees")
  inc=$(cfg BUSY_CALENDARS)
  exc=$(cfg IGNORE_CALENDARS)
  [ -n "$inc" ] && args+=(-ic "$inc")
  [ -n "$exc" ] && args+=(-ec "$exc")

  ignore_re=$(cfg IGNORE_TITLES)
  me=$(cfg ME)

  # Keep only the events that are actually appointments with someone.
  #
  # icalBuddy prints a title at column 0 and, when the event has them, an
  # indented "attendees:" continuation line. So this reads two lines per event
  # and applies two filters:
  #
  #   IGNORE_TITLES  drops routine self-blocks by name (Sleep, Dinner, Be in
  #                  Bed). Left in, a life-structure calendar is an unbroken
  #                  wall of "meetings" that mutes most of the day.
  #
  #   ME             drops anything with no attendee other than you. A block
  #                  you put on your own calendar -- "Work on X", "General
  #                  Admin", a webinar you alone RSVP'd to -- is time you
  #                  chose, not time you owe anybody, and a 30 second set is
  #                  exactly the interruption it can absorb. Only a second
  #                  human on the invite buys silence.
  #
  # The cost: a real meeting you typed yourself, with nobody invited, reads as
  # a solo block and gets a banner. That is the trade this whole file already
  # makes -- a stray banner beats a reminder system that quietly stops.
  real_commitments() {
    awk -v ignore="$ignore_re" -v me="$me" '
      BEGIN {
        n = split(me, m, ",")
        for (i = 1; i <= n; i++) {
          gsub(/^[ \t]+|[ \t]+$/, "", m[i])
          if (m[i] != "") mine[tolower(m[i])] = 1
        }
      }
      function flush() {
        if (title == "") return
        if (with_others && !(ignore != "" && tolower(title) ~ tolower(ignore)))
          print title
        title = ""; with_others = 0
      }
      /^[[:space:]]*$/ { next }
      /^[[:space:]]+attendees:/ {
        sub(/^[[:space:]]*attendees:[[:space:]]*/, "")
        k = split($0, a, ",")
        for (i = 1; i <= k; i++) {
          gsub(/^[ \t]+|[ \t]+$/, "", a[i])
          if (a[i] != "" && !(tolower(a[i]) in mine)) with_others = 1
        }
        next
      }
      /^[[:space:]]/ { next }
      { flush(); title = $0 }
      END { flush() }
    '
  }

  out=$("$ical" "${args[@]}" eventsNow 2>/dev/null | real_commitments || true)
  if [ -n "$out" ]; then
    busy_now=yes
  else
    out=$("$ical" "${args[@]}" eventsFrom:now to:"+$SOON_MINS minutes" 2>/dev/null \
          | real_commitments || true)
    [ -n "$out" ] && starts_soon=yes
  fi
fi

# The hub decides the channel before the Hammerspoon probe below, which can
# take 8s. A :20 claim has to land before the :22 phone job. Debounce, the
# waking window and a local pause already returned, so a quiet fire never
# claims the hour.
if [ -n "$(cfg HUB)" ]; then
  route_ask
  case "$ROUTE_RESULT" in
    phone|handoff|skip:*) exit 0 ;;
  esac
fi

if [ "$busy_now" = yes ]; then
  # Deliberately does NOT stamp. Leaving the slot unburned means the next fire,
  # 30 minutes later, catches Ben the moment the meeting ends rather than
  # idling for a full hour.
  #
  # A laptop claim still shows the dialog. Exiting here would own the hour
  # with no handoff, and the phone job would not send either. The meeting is
  # recorded on the slot; it does not skip the nudge yet. With no hub, or
  # with the hub unreachable, today's suppression stands.
  if [ -z "$(cfg HUB)" ] || [ "${ROUTE_RESULT:-}" != laptop ]; then
    note "skip: in a meeting ($(printf '%s' "$out" | head -1))"
    exit 0
  fi
fi

# --- 6. what to do ----------------------------------------------------------
line=$(primary_option "$where")
if [ "$starts_soon" = yes ]; then
  title="GTG - meeting soon"
  prompt="Meeting in a few minutes. Squeeze one in:"
elif [ "$where" = away ]; then
  title="GTG - out"
  prompt="Move your body:"
else
  title="GTG"
  prompt="Time for a set. What did you do?"
fi

# --- 7. ask -----------------------------------------------------------------
style=$(cfg STYLE); style=${style:-picker}
sound=$(cfg SOUND); sound=${sound:-Ping}
speak=$(cfg SPEAK)

# 15 min, then the dialog dismisses ITSELF and the slot retries. Kept well
# under the 30 min gap between fires, so a dialog is always gone before the
# next one is due and two can never share the screen. Five minutes when this
# machine asks the hub: a :50 give-up still lands inside the hour, so the
# handoff can reach the phone. An explicit DIALOG_TIMEOUT in the plan wins.
DIALOG_TIMEOUT=$(cfg DIALOG_TIMEOUT)
if [ -z "$DIALOG_TIMEOUT" ]; then
  if [ -n "$(cfg HUB)" ]; then DIALOG_TIMEOUT=300; else DIALOG_TIMEOUT=900; fi
fi

# --- what is on screen: observed, written down, not yet acted on ------------
# The calendar check above never fired once in its first three weeks, and the
# microphone is no signal on this Mac (Wispr Flow holds it open to dictate).
# So each fire asks Hammerspoon whether a call window is open and records the
# answer beside what Ben then did. `gtg fires` counts the two together, and
# only a week of that earns this line the right to suppress a nudge.
#
# Fails open three ways: no hs binary, hs not answering within the deadline,
# or any error at all. The nudge fires regardless, with "seen:" saying why.
if [ -n "${GTG_HS+x}" ]; then
  HS=$GTG_HS
else
  HS=$(command -v hs 2>/dev/null || true)
  [ -n "$HS" ] || [ ! -x /opt/homebrew/bin/hs ] || HS=/opt/homebrew/bin/hs
fi
seen="hs not installed"
if [ -n "$HS" ]; then
  seen_out=$(mktemp)
  "$HS" -c 'return gtgBar.meetingWindow()' >"$seen_out" 2>/dev/null &
  hs_pid=$!
  # Polled rather than `timeout`, which launchd's PATH does not carry.
  for _ in 1 2 3 4 5 6 7 8; do kill -0 "$hs_pid" 2>/dev/null || break; sleep 1; done
  if kill -0 "$hs_pid" 2>/dev/null; then
    kill "$hs_pid" 2>/dev/null; seen="hs did not answer in 8s"
  else
    seen=$(grep -v '^-- ' "$seen_out" | head -1)
    seen=${seen:-no meeting window}
  fi
  rm -f "$seen_out"
fi
note "seen: $seen"

# One dialog at a time. `choose from list` cannot time itself out, so without
# this an unanswered dialog would sit forever holding the lock and mute every
# later nudge -- the same silent death the banner already died once.
LOCK="$STATE_DIR/nudge.lock"
DIALOG_PID="$STATE_DIR/dialog.pid"

# Reap a dialog stranded by an earlier run before opening a new one. With the
# `with timeout of` fix below this should never fire, but a stale window shows
# a stale recommendation, so replace it rather than let it accumulate.
if [ -e "$DIALOG_PID" ]; then
  stale=$(cat "$DIALOG_PID" 2>/dev/null)
  case "$stale" in ''|*[!0-9]*) stale="" ;; esac
  if [ -n "$stale" ] && kill -0 "$stale" 2>/dev/null; then
    kill "$stale" 2>/dev/null
    note "replaced a stranded dialog"
  fi
  rm -f "$DIALOG_PID"
fi

if [ -e "$LOCK" ] && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; then
  note "skip: a dialog is already open"
  exit 0
fi
printf '%s' "$$" >"$LOCK"
trap 'rm -f "$LOCK"' EXIT

# Audible first, and backgrounded, so it lands even if you are looking away and
# never delays the dialog.
if [ -n "$sound" ] && [ -r "/System/Library/Sounds/$sound.aiff" ]; then
  /usr/bin/afplay "/System/Library/Sounds/$sound.aiff" >/dev/null 2>&1 &
fi
if [ "$speak" = yes ]; then
  /usr/bin/say "$line" >/dev/null 2>&1 &
fi

# Everything below is a modal WINDOW, not a Notification Center banner. That is
# deliberate and was measured: osascript's `display notification` posts under a
# bundle with no entry in ~/Library/Preferences/com.apple.ncprefs on this Mac,
# so macOS drops it silently -- the job fires, logs success, and nothing ever
# appears. A window needs no notification permission, survives Focus, and does
# not evaporate after five seconds.
#
# Dialogs are addressed to the frontmost application so they open in front of
# whatever is being looked at, instead of behind everything as a background
# process's window would.

# Plain runner. Nothing here ever kills a dialog, and that is the entire point.
#
# The previous version enforced its own timeout by killing osascript. But the
# dialog is displayed BY the target application, not by osascript, so killing
# osascript left a live window on screen that nothing would ever collect. The
# script then exited, released the lock, and the next nudge opened another on
# top of it. That is how three stacked up.
#
# Every dialog below now carries its own `giving up after`, so macOS dismisses
# them and there is nothing left to reap.
osa() {
  local out pid bin
  bin=${GTG_OSASCRIPT:-/usr/bin/osascript}
  out=$(mktemp)
  "$bin" >"$out" 2>/dev/null <<<"$1" &
  pid=$!
  printf '%s' "$pid" >"$DIALOG_PID"
  wait "$pid" 2>/dev/null || true
  rm -f "$DIALOG_PID"
  cat "$out"
  rm -f "$out"
}

# One recommendation and one button, rather than a menu to weigh. The rotation
# already put the right movement on top, so the default answer is nearly always
# correct; alternatives are named in the message and reachable via Other...
#
# Three buttons is also the hard limit of `display alert` -- and unlike
# `choose from list`, it supports `giving up after`, which is what makes the
# orphaned-dialog bug above structurally impossible.
# `with timeout of` is the whole ballgame, and its absence was the bug.
#
# An Apple Event carries a default 120 second ceiling. `giving up after 900`
# asks the dialog to live 15 minutes, so osascript gave up at two minutes and
# exited while the application kept the window on screen -- forever, since
# nothing was left to dismiss it. The script then logged "no answer (timed
# out)", released the lock, and 30 minutes later stacked another on top. Twelve
# log lines claiming a timeout, five live windows: the log and the screen
# disagreed, and the screen was right.
#
# Measured 2026-08-14, both shapes asking for a 150s dialog, unattended:
#
#   without `with timeout of`  osascript exited at 121s, rc=1,
#                              "AppleEvent timed out. (-1712)", empty stdout,
#                              and the window was STILL ON SCREEN afterwards
#   with `with timeout of 210` osascript exited at 150s, rc=0, "__TIMEOUT__",
#                              zero windows left, no orphan process
#
# The ceiling is 121s in practice, so DIALOG_TIMEOUT + 60 clears it by a wide
# margin at every setting worth using. The empty stdout in the broken case is
# why an empty result is now an error rather than a timeout: that string was
# the bug's only signature, and it was being swallowed.
#
# System Events rather than the frontmost application, for two reasons. It is
# a proper background agent, so the dialog renders as a standard alert instead
# of whatever a arbitrary app makes of the event -- the mangled window with no
# text field was iTerm2's rendering. And it measured 1s against 5s.
#
# The three scripts themselves -- alert_for, other_for, confirm_new_for -- live
# in gtg-lib.sh so the test suite can compile every one of them. They read
# $title and $DIALOG_TIMEOUT from here.

if [ "$style" = banner ]; then
  # Kept for reference only. See the note above: on this Mac it very likely
  # shows nothing at all.
  "${GTG_OSASCRIPT:-/usr/bin/osascript}" -e "display notification \"$(esc "$line")\" \
     with title \"$(esc "$title")\" sound name \"Ping\"" 2>/dev/null || true
else
  # Name the next couple of alternatives in the message, so what else is due
  # stays visible without turning the nudge back into a menu.
  hint=$(today_options "$where" | sed -n '2,3p' \
         | awk 'NR > 1 { printf " / " } { printf "%s", $0 } END { if (NR) print "" }')
  msg="$line"
  if [ -n "$hint" ]; then
    msg="$line

or: $hint"
  fi

  DIALOG_OPENED=$(date +%s)
  ELSEWHERE="$STATE_DIR/dialog.elsewhere"
  rm -f "$ELSEWHERE"
  watcher=""
  case "${ROUTE_RESULT:-}:${ROUTE_SLOT:-}" in
    laptop:????-??-??T??)
      watch_elsewhere &
      watcher=$! ;;
  esac
  answer=$(osa "$(alert_for "$msg")")
  if [ -n "$watcher" ]; then
    pkill -P "$watcher" 2>/dev/null || true
    kill "$watcher" 2>/dev/null || true
  fi

  # Our own Snooze press, because the set was logged somewhere else. Stamped
  # like a logged answer, so the next fire is debounced rather than asking
  # for a set that is already done.
  if [ "$answer" = Snooze ] && [ -s "$ELSEWHERE" ]; then
    note "dismissed: logged elsewhere ($(cat "$ELSEWHERE"))"
    rm -f "$ELSEWHERE"
    route_answered elsewhere
    printf '%s' "$now" >"$STAMP"
    exit 0
  fi
  rm -f "$ELSEWHERE"

  case "$answer" in
    # Empty now means the dialog FAILED TO DISPLAY, which is a different
    # problem from being ignored, and previously both logged the same line.
    "")
      note "ERROR: dialog did not display"
      maybe_handoff force
      exit 1 ;;
    "__TIMEOUT__")
      note "no answer (dismissed itself after ${DIALOG_TIMEOUT}s)"
      maybe_handoff
      exit 0 ;;
    "Snooze")
      note "snoozed"
      route_answered snooze
      exit 0 ;;                # unstamped, retries
    "Other...")
      typed=$(osa "$(other_for "$line")")
      case "$typed" in
        "")            note "ERROR: text dialog did not display"; exit 1 ;;
        "__CANCEL__")  note "other: cancelled"; exit 0 ;;
        "__TIMEOUT__") note "other: unanswered"; exit 0 ;;
      esac
      line="$typed"

      # "off", "not today", "sick": sometimes the honest answer to the nudge
      # is that there will be no set today. It is taken HERE, in the box that
      # is already open, because this is the moment the nuisance is felt --
      # asking Ben to find a menu instead is how he learns to ignore the
      # dialog rather than answer it. Unstamped, so nothing counts as done.
      if parse_pause "$line"; then
        if ! ends=$(pause_ends "$PAUSE_FOR"); then ends=$(pause_ends); fi
        pause_set "$ends" "$PAUSE_REASON"
        note "paused until $(pause_human "$ends")${PAUSE_REASON:+ ($PAUSE_REASON)}"
        hub_forward_off
        route_answered off
        exit 0
      fi

      # The same "@8am ..." prefix the CLI and the menu bar take, so one input
      # habit works everywhere -- you answer a nudge at ten having done the set
      # at seven, and it lands at seven.
      case "$line" in
        @*)
          split_at "$line"
          if [ -n "$AT_ISO" ] && [ -n "$AT_REST" ]; then
            export GTG_AT="$AT_ISO"; line="$AT_REST"
            note "backdated to $AT_ISO"
          else
            note "no readable time in \"$line\"; logging it as typed"
          fi ;;
      esac

      # One movement or a whole round, "and" or ";" between sets: everything
      # typed goes through record_batch, checked in full so nothing half-lands.
      #
      # A movement it does not know is a QUESTION, not a guess -- the old
      # code silently snapped it to whatever known name was within an edit
      # distance of two, which quietly merged "Incline Press" into "Decline
      # Press". The line comes back in a text field: fix the spelling and it
      # resolves, or log it as typed and the log is what makes it known from
      # then on. "Add to pool" also offers it every day.
      #
      # Bounded: once "Log it" or "Add to pool" is pressed an unknown name is
      # accepted, so the retry can only fail by being unreadable, which exits.
      #
      # Falls THROUGH on success, so the debounce stamp below still gets
      # written -- a logged round is an answered nudge. Only a failure exits
      # early, unstamped, the same way every other failure here does, so the
      # next fire tries again rather than counting a rejection as done.
      GTG_NEW=""; reading=""; tab=$(printf '\t')
      while :; do
        err=$(mktemp)
        out=$(record_smart "$line" "$where" 2>"$err"); rc=$?
        reading=$(sed -n 's/^read as: //p' "$err" | head -1)
        if [ "$rc" -eq 0 ]; then
          rm -f "$err"
          line=$(printf '%s' "$out" | paste -sd';' -)
          note "logged${GTG_NEW:+ (new movement)}${reading:+ (read as: $reading)}: $line"
          ANSWERED_HOW=log
          break
        fi
        unknown=$(sed -n 's/^unknown movement: //p' "$err" | head -1); rm -f "$err"
        # The box comes back holding the READING when there is one. A
        # sentence the model turned into "sled push x5" is one word from being
        # right; handing back the raw dictation makes it be retyped instead.
        [ -n "$reading" ] && line="$reading"
        if [ "$rc" -ne 3 ]; then note "could not read that as a movement: $line"; exit 0; fi
        # Three different non-answers, three different lines. "declined" once
        # covered all of them, and for three weeks it was recording a prompt
        # that had failed to compile as a person clicking Cancel.
        reply=$(osa "$(new_for "$unknown" "$line")")
        case "$reply" in
          "__CANCEL__")        note "unknown movement declined: $unknown"; exit 0 ;;
          "__TIMEOUT__")       note "unknown movement, prompt unanswered: $unknown"; exit 0 ;;
          "Log it$tab"*)       GTG_NEW=log;  line=${reply#*"$tab"} ;;
          "Add to pool$tab"*)  GTG_NEW=pool; line=${reply#*"$tab"} ;;
          *)                   note "ERROR: new-movement prompt did not display for: $unknown"; exit 1 ;;
        esac
      done
      ;;
    *)  # "Did it"
      # Through record_option, not record: the line on screen may carry an
      # "@ 50 lb" this tool added, and it belongs in the weight column rather
      # than glued onto the movement name.
      line=$(record_option "$line" "$where")
      note "logged: $line"
      ANSWERED_HOW=log
      ;;
  esac
fi

# --- 8. stamp ---------------------------------------------------------------
if [ -n "${ANSWERED_HOW:-}" ]; then
  route_answered "$ANSWERED_HOW"
fi
printf '%s' "$now" >"$STAMP"
note "nudged ($where): $line"
