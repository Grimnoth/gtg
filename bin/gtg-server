#!/usr/bin/python3
"""HTTP face for the gtg CLI.

Every read and write is a subprocess of bin/gtg (or bin/gtg-page for the
dashboard), except plans and slot routing. They read state directly and share
the write lock with logging.
"""

import base64
import hashlib
import hmac
import json
import os
import secrets
import socket
import subprocess
import sys
import tempfile
import threading
import time
from datetime import date
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlencode, urlsplit
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
GTG = os.path.join(HERE, "gtg")
PAGE = os.path.join(HERE, "gtg-page")
AGENT_MD = os.path.join(ROOT, "docs", "agent.md")

CONF_DIR = os.environ.get("GTG_CONF_DIR") or os.path.expanduser("~/.config/gtg")
STATE_DIR = os.environ.get("GTG_STATE_DIR") or os.path.expanduser("~/.local/state/gtg")
TOKEN_PATH = os.path.join(CONF_DIR, "token")
MAX_BODY = 64 * 1024
PAGE_TTL = 60

# cfg INTERPRET only reads plan.txt, so GTG_INTERPRET=off does not stop the
# interpreter. GTG_INTERPRET_CMD is the switch gtg-interpret does honor:
# /usr/bin/true prints nothing and the original refusal stands, with no model
# call. A hit in the interpret cache is returned before either switch. That
# cache lives in bin/gtg-interpret.
LOG_ENV = {
    "GTG_INTERPRET": "off",
    "GTG_INTERPRET_CMD": "/usr/bin/true",
}

# The only writer of slots.tsv. The laptop and the :22/:52 job only POST, so
# they take this same lock instead of a second one. A file lock is what you
# would add to share the file with another process; there is no other process.
# Held across the webhook too: releasing it before the POST would let a second
# caller send for the same slot.
WRITE_LOCK = threading.Lock()
PAGE_AT = [0.0]
TOKEN = ""

# Oura OAuth state is short-lived and only needed until the browser comes back.
# Tokens and the energy cache live on disk under CONF_DIR / STATE_DIR.
OURA_SCOPE = "daily"
OURA_STATE_TTL = 600
OURA_CACHE_TTL = 45 * 60
OURA_TZ = "America/New_York"
OURA_REDIRECT_DEFAULT = "https://bens-mac-mini.twin-viper.ts.net/gtg/oura/callback"
OURA_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
OURA_STATES = {}
OURA_LOCK = threading.Lock()

PROTOCOLS = ("2025-06-18", "2025-03-26", "2024-11-05")
DEFAULT_PROTOCOL = "2025-06-18"
PERIODS = ("today", "week", "history", "stats", "status")


def die(msg):
    sys.stderr.write("gtg-server: %s\n" % msg)
    sys.exit(1)


def load_token():
    try:
        with open(TOKEN_PATH, "r", encoding="utf-8") as fh:
            token = fh.read().strip()
    except OSError:
        token = ""
    if not token:
        die("refusing to start: %s is missing or empty" % TOKEN_PATH)
    return token


def listen_port():
    raw = os.environ.get("GTG_PORT", "8796")
    try:
        n = int(raw)
    except (TypeError, ValueError):
        die("GTG_PORT is not a number: %s" % raw)
    if n < 1 or n > 65535:
        die("GTG_PORT is out of range: %s" % raw)
    return n


def as_dict(value):
    return value if isinstance(value, dict) else {}


def gtg(args, extra_env=None, write=False):
    env = os.environ.copy()
    if extra_env:
        env.update(extra_env)

    def run():
        proc = subprocess.run(
            [GTG] + list(args),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            universal_newlines=True,
        )
        return proc.returncode, proc.stdout, proc.stderr

    if write:
        with WRITE_LOCK:
            return run()
    return run()


def envelope(rc, out, err):
    return {"ok": rc == 0, "output": out, "error": err if err else None}


def list_movements(args):
    # known_movements is not a gtg command. options is today's pool; stats is
    # every movement that has been logged, which is the closest the CLI comes.
    rc1, opt, err1 = gtg(["options"])
    rc2, stats, err2 = gtg(["stats"])
    parts = []
    if opt:
        parts.append(opt.rstrip("\n"))
    if stats:
        parts.append(stats.rstrip("\n"))
    output = ("\n".join(parts) + "\n") if parts else ""
    err = (err1 or "") + (err2 or "")
    ok = rc1 == 0 and rc2 == 0
    status = 200 if ok else 400
    return status, {"ok": ok, "output": output, "error": err or None}


def decimal(value):
    # Query strings and JSON both arrive here. Reject bool (it is an int) and
    # anything that is not plain base-10, so a stray character cannot throw
    # out of int() and take the request down.
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value if value >= 0 else None
    if isinstance(value, str) and value != "" and all("0" <= c <= "9" for c in value):
        return int(value)
    return None


def get_summary(args):
    args = as_dict(args)
    period = args.get("period")
    if period not in PERIODS:
        return 400, {
            "ok": False,
            "output": "",
            "error": "period must be today, week, history, stats, or status",
        }
    cmd = [period]
    days = args.get("days")
    if period == "history" and days is not None and days != "":
        n = decimal(days)
        if n is None:
            return 400, {"ok": False, "output": "", "error": "days must be a number"}
        cmd.append(str(n))
    rc, out, err = gtg(cmd)
    return (200 if rc == 0 else 400), envelope(rc, out, err)


def pause(args):
    args = as_dict(args)
    dur = args.get("for")
    reason = args.get("reason")
    if dur is not None and not isinstance(dur, str):
        return 400, {"ok": False, "output": "", "error": "for must be a string"}
    if reason is not None and not isinstance(reason, str):
        return 400, {"ok": False, "output": "", "error": "reason must be a string"}
    cmd = ["off"]
    if isinstance(dur, str) and dur.strip():
        cmd.append(dur.strip())
    if isinstance(reason, str) and reason.strip():
        cmd.append(reason.strip())
    rc, out, err = gtg(cmd, write=True)
    return (200 if rc == 0 else 400), envelope(rc, out, err)


def resume(args):
    rc, out, err = gtg(["on"], write=True)
    return (200 if rc == 0 else 400), envelope(rc, out, err)


def log_sets(args):
    with WRITE_LOCK:
        return _log_sets(args)


def _log_sets(args):
    args = as_dict(args)
    text = args.get("text")
    at = args.get("at")
    plan_slot = args.get('plan_slot')
    if plan_slot is not None:
        if not _slot_key_ok(plan_slot) or plan_slot[:10] != _slot_now()[:10]:
            return 400, {'ok': False, 'error': 'plan_slot must be a slot on today\'s plan'}
        try:
            plan = _plan_progress(plan_slot[:10])['plan']
        except (OSError, ValueError):
            return 500, {'ok': False, 'error': 'could not read plan'}
        if plan is None or not any(slot['hour'] == int(plan_slot[11:]) for slot in plan['slots']):
            return 400, {'ok': False, 'error': 'plan_slot must be a slot on today\'s plan'}
    new = args.get("new") is True
    if not isinstance(text, str) or not text.strip():
        return 400, {"ok": False, "output": "", "error": "text is required"}
    if at is not None and not isinstance(at, str):
        return 400, {"ok": False, "output": "", "error": "at must be a string"}
    cmd = []
    if new:
        cmd.append("--new")
    if isinstance(at, str) and at.strip():
        stamp = at.strip()
        if not stamp.startswith("@"):
            stamp = "@" + stamp
        cmd.append(stamp)
    cmd.append(text)
    rc, out, err = gtg(cmd, LOG_ENV)
    body = envelope(rc, out, err)
    if rc == 0:
        if plan_slot is not None:
            perform_answered('log', plan_slot)
            _append_slot(plan_slot, 'skip', 'done')
        return 200, body
    # gtg turns record_batch's rc 3 into exit 1, same as a parse failure.
    # The refusal line is what distinguishes "not logged" from "could not read".
    if "unknown movement:" in (err or ""):
        _status, known = list_movements({})
        body["known"] = known.get("output") or ""
        return 422, body
    return 400, body


# --- one slot, one ping -----------------------------------------------------
# A slot is one waking hour, key YYYY-MM-DDTHH. slots.tsv is append-only.
# The owner is the last of laptop/phone/handoff/skip. answered does not own.

OWNERS = ("laptop", "phone", "handoff", "skip")


def slot_route(slot, now, laptop_idle_s, set_logged_this_hour, paused,
               in_waking_window, idle_present=180, laptop_where=None):
    """Where an unclaimed slot goes. First match wins.

    slot and now are the caller's key and clock. The booleans are already
    decided from the log, the pause file and the plan, so this table does
    not touch the disk.
    """
    del slot, now
    if set_logged_this_hour:
        return "skip:done"
    if paused:
        return "skip:paused"
    if not in_waking_window:
        return "skip:asleep-hours"
    try:
        present = int(idle_present)
    except (TypeError, ValueError):
        present = 180
    if present < 1:
        present = 180
    # Away from home the phone is the channel even at the keyboard: a dialog
    # on a laptop Ben is working remote on is an interruption, not a nudge.
    # No where at all (an older client) keeps the idle rule.
    if laptop_where == "away":
        return "phone"
    if laptop_idle_s is not None and laptop_idle_s < present:
        return "laptop"
    return "phone"


def _slot_now():
    return time.strftime("%Y-%m-%dT%H")


def _slot_key_ok(slot):
    if not isinstance(slot, str) or len(slot) != 13 or slot[10] != "T":
        return False
    date, hour = slot[:10], slot[11:]
    if len(date) != 10 or date[4] != "-" or date[7] != "-":
        return False
    if not (date[:4].isdigit() and date[5:7].isdigit() and date[8:10].isdigit()):
        return False
    if not hour.isdigit():
        return False
    return 0 <= int(hour) <= 23


def _plan_routing():
    wake_s, wake_e, present = 9, 21, 180
    path = os.path.join(CONF_DIR, "plan.txt")
    try:
        fh = open(path, "r", encoding="utf-8", errors="replace")
    except OSError:
        return wake_s, wake_e, present
    with fh:
        for line in fh:
            line = line.split("#", 1)[0].strip()
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            key, value = key.strip(), value.strip()
            if not value.isdigit():
                continue
            n = int(value)
            if key == "WAKE_START":
                wake_s = n
            elif key == "WAKE_END":
                wake_e = n
            elif key == "IDLE_PRESENT" and n >= 1:
                present = n
    return wake_s, wake_e, present


def _hour_in_window():
    wake_s, wake_e, _present = _plan_routing()
    hour = int(time.strftime("%H"))
    return hour >= wake_s and hour < wake_e


def _idle_present():
    return _plan_routing()[2]


def _read_paused():
    # Same rule as pause_active: a future epoch is paused, and an expired or
    # unreadable file is deleted as it is read so it cannot mute the tool.
    path = os.path.join(STATE_DIR, "paused")
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            raw = fh.read().split("\t", 1)[0].strip()
    except OSError:
        return False
    if raw.isdigit() and int(raw) > int(time.time()):
        return True
    try:
        os.remove(path)
    except OSError:
        pass
    return False


def _log_path():
    return os.path.join(STATE_DIR, "log.tsv")


def _log_size():
    try:
        return os.path.getsize(_log_path())
    except OSError:
        return 0


def _is_set_row(cols):
    if len(cols) < 2 or not cols[0] or not cols[1]:
        return False
    reps = cols[2] if len(cols) > 2 else ""
    return reps != "skip"


def _each_log_row():
    try:
        fh = open(_log_path(), "r", encoding="utf-8", errors="replace")
    except OSError:
        return
    with fh:
        for line in fh:
            yield line.rstrip("\n").split("\t")


def set_logged_this_hour(slot):
    # The colon is the whole test. "T09:" must not match a set logged at 19.
    prefix = slot + ":"
    for cols in _each_log_row():
        ts = cols[0] if cols else ""
        if ts != slot and not ts.startswith(prefix):
            continue
        if _is_set_row(cols):
            return True
    return False


def _non_skip_since(offset):
    try:
        size = os.path.getsize(_log_path())
    except OSError:
        return False
    if size <= offset:
        return False
    try:
        fh = open(_log_path(), "r", encoding="utf-8", errors="replace")
    except OSError:
        return False
    with fh:
        # log_end is the file size at claim time, so it is the first byte of
        # the next row. Discarding a line here drops that row.
        fh.seek(offset)
        for line in fh:
            if _is_set_row(line.rstrip("\n").split("\t")):
                return True
    return False


def _log_end(detail):
    for part in (detail or "").split(";"):
        if part.startswith("log_end="):
            raw = part[len("log_end="):]
            if raw.isdigit():
                return int(raw)
    return None


def _slots_path():
    return os.path.join(STATE_DIR, "slots.tsv")


def _slot_owner(slot):
    owner, detail = None, ""
    try:
        fh = open(_slots_path(), "r", encoding="utf-8", errors="replace")
    except OSError:
        return None, ""
    with fh:
        for line in fh:
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 3 or parts[1] != slot:
                continue
            if parts[2] in OWNERS:
                owner = parts[2]
                detail = parts[3] if len(parts) > 3 else ""
    return owner, detail


def _append_slot(slot, event, detail):
    detail = (detail or "").replace("\t", " ").replace("\n", " ").replace("\r", " ")
    ts = time.strftime("%Y-%m-%dT%H:%M:%S")
    with open(_slots_path(), "a", encoding="utf-8") as fh:
        fh.write("%s\t%s\t%s\t%s\n" % (ts, slot, event, detail))


def _hub_note(msg):
    # Loud lines only. The clients write "routed:" themselves; writing it
    # here too would put the decision in the log twice.
    path = os.path.join(STATE_DIR, "nudge.log")
    stamp = time.strftime("%Y-%m-%d %H:%M")
    try:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write("%s  %s\n" % (stamp, msg))
    except OSError:
        sys.stderr.write("gtg-server: %s\n" % msg)


def _owner_route(owner, detail):
    if owner is None:
        return "none"
    if owner == "skip":
        reason = (detail or "").split(";", 1)[0] or "skip"
        return "skip:" + reason
    return owner


def _meet(meeting):
    return "1" if meeting else "0"


def _compact_hours(hours):
    nums = []
    for hour in hours:
        if hour.isdigit():
            n = int(hour)
            if n not in nums:
                nums.append(n)
    nums.sort()
    if not nums:
        return "none"
    ranges = []
    start = prev = nums[0]
    for n in nums[1:]:
        if n == prev + 1:
            prev = n
            continue
        ranges.append((start, prev))
        start = prev = n
    ranges.append((start, prev))
    parts = []
    for a, b in ranges:
        if a == b:
            parts.append("%02d" % a)
        else:
            parts.append("%02d-%02d" % (a, b))
    return " ".join(parts)


def progress_line(slot=None):
    # Non-skip rows only. today_report's count includes skips; a skipped set
    # is not progress. Same rep rule as that report: digits, nothing else.
    day = (slot or _slot_now())[:10]
    sets = 0
    reps = 0
    hours = []
    for cols in _each_log_row():
        if not cols or not cols[0].startswith(day):
            continue
        if not _is_set_row(cols):
            continue
        sets += 1
        rep = cols[2] if len(cols) > 2 else ""
        if rep.isdigit():
            reps += int(rep)
        if len(cols[0]) >= 13:
            hour = cols[0][11:13]
            if hour not in hours:
                hours.append(hour)
    word = "set" if sets == 1 else "sets"
    return "%d %s, %d reps, hours %s done" % (sets, word, reps, _compact_hours(hours))


def _nudge_context(where=None):
    # where_am_i and primary_option, not `gtg status`. status pulls from the
    # hub when HUB= is set, and a route must not ssh. Three seconds: a hung
    # gateway lookup must not outlive the client's 25s and also send.
    # A caller that already knows home or away must not ask where_am_i: on
    # the hub that answer is always home.
    if where in ("home", "away"):
        script = (
            '. "$1"\n'
            'pick=$(primary_option "$2")\n'
            "printf '%s\\n' \"$2\"\n"
            "printf '%s\\n' \"$pick\"\n"
        )
        cmd = ["bash", "-c", script, "gtg-context",
               os.path.join(HERE, "gtg-lib.sh"), where]
    else:
        script = (
            '. "$1"\n'
            'where=$(where_am_i)\n'
            'pick=$(primary_option "$where")\n'
            "printf '%s\\n' \"$where\"\n"
            "printf '%s\\n' \"$pick\"\n"
        )
        cmd = ["bash", "-c", script, "gtg-context",
               os.path.join(HERE, "gtg-lib.sh")]
        where = None
    try:
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=os.environ.copy(),
            universal_newlines=True,
            timeout=3,
        )
    except (subprocess.TimeoutExpired, OSError):
        return where or "away", "do a quick set"
    if proc.returncode != 0:
        return where or "away", "do a quick set"
    lines = (proc.stdout or "").splitlines()
    got = lines[0].strip() if lines else ""
    pick = lines[1].strip() if len(lines) > 1 else ""
    if got not in ("home", "away"):
        got = where or "away"
    if not pick:
        pick = "do a quick set"
    return got, pick


def _with_where(detail, client_where):
    if client_where in ("home", "away"):
        return "%s;where=%s" % (detail, client_where)
    return detail


def _reported_where(slot):
    # Last where= on today's rows. A hub-only row does not write one, so a
    # fallback to where_am_i is not replayed as a laptop report.
    day = (slot or "")[:10]
    if len(day) != 10:
        return None
    found = None
    try:
        fh = open(_slots_path(), "r", encoding="utf-8", errors="replace")
    except OSError:
        return None
    with fh:
        for line in fh:
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 4 or not parts[1].startswith(day):
                continue
            for piece in parts[3].split(";"):
                if not piece.startswith("where="):
                    continue
                val = piece[len("where="):]
                if val in ("home", "away"):
                    found = val
    return found


def _channel_context(client_where, slot):
    if client_where in ("home", "away"):
        return _nudge_context(client_where)
    prior = _reported_where(slot)
    if prior:
        return _nudge_context(prior)
    return _nudge_context()


def _posted_where(body):
    if "where" not in body or body.get("where") is None:
        return None
    where = body.get("where")
    if where in ("home", "away"):
        return where
    return False


def _webhook_creds():
    path = os.path.join(CONF_DIR, "grok-webhook")
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return None
    if len(lines) < 2:
        return None
    url, key = lines[0].strip(), lines[1].strip()
    if not url or not key:
        return None
    return url, key


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    # A 3xx must not be followed. The key is in the headers, and the next
    # hop is not necessarily the host it was written for.
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _post_webhook(url, key, payload):
    # Returns None on success, otherwise a status word. The word is an HTTP
    # code, "timeout", or "error". Never the URL and never the key: urllib's
    # own exceptions carry the URL.
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, method="POST")
    req.add_header("Content-Type", "application/json")
    req.add_header("Authorization", "Bearer " + key)
    req.add_header("X-Automation-Key", key)
    opener = urllib.request.build_opener(_NoRedirect())
    try:
        resp = opener.open(req, timeout=15)
        try:
            code = resp.getcode()
            resp.read()
        finally:
            resp.close()
    except urllib.error.HTTPError as exc:
        return str(exc.code)
    except socket.timeout:
        return "timeout"
    except urllib.error.URLError as exc:
        if isinstance(getattr(exc, "reason", None), socket.timeout):
            return "timeout"
        return "error"
    except Exception:
        return "error"
    if code < 200 or code >= 300:
        return str(code)
    return None


def _send_channel(event, slot, meeting, client_where=None):
    meet = _meet(meeting)
    creds = _webhook_creds()
    if creds is None:
        _append_slot(slot, "skip", _with_where("no-webhook;meeting=%s" % meet, client_where))
        _hub_note("ERROR: no grok-webhook file; %s not sent (no-webhook)" % event)
        return "skip:no-webhook"
    url, key = creds
    where, pick = _channel_context(client_where, slot)
    try:
        plan = _plan_next()
    except (OSError, ValueError):
        plan = {'ok': False, 'plan': None, 'error': 'could not read plan progress'}
    payload = {
        "pick": pick,
        "where": where,
        "progress": progress_line(slot),
        "slot": slot,
        "plan": plan,
    }
    status = _post_webhook(url, key, payload)
    if status is None:
        _append_slot(slot, event, _with_where("meeting=%s" % meet, client_where))
        return event
    # ponytail: one attempt, then the hour is owned as phone even though the
    # POST failed. A second ping is worse than a missed one. Ceiling: a crash
    # after a successful POST and before this append can send again on the
    # next route. Upgrade: append the phone row first and treat that row as
    # already sent.
    _append_slot(slot, "phone", _with_where("webhook-failed:%s" % status, client_where))
    _hub_note("ERROR: webhook failed for %s: status %s" % (slot, status))
    return "phone"


def _handoff_blocked(slot, detail):
    # Anything appended after the claim, including a row backdated into an
    # earlier hour. Also a row that landed in this hour between the emptiness
    # check and the byte offset, which the offset itself would miss.
    offset = _log_end(detail)
    if offset is not None and _non_skip_since(offset):
        return True
    return set_logged_this_hour(slot)


def perform_route(idle, meeting, client_where=None):
    slot = _slot_now()
    owner, detail = _slot_owner(slot)
    # A laptop hour with a set logged since the claim is done, so the :50
    # retry stays quiet. Answered, not written: the owner does not change.
    if owner == "laptop" and _handoff_blocked(slot, detail):
        return "skip:done", slot
    if owner:
        return _owner_route(owner, detail), slot
    decision = slot_route(
        slot, time.strftime("%Y-%m-%dT%H:%M:%S"), idle,
        set_logged_this_hour(slot), _read_paused(), _hour_in_window(),
        _idle_present(), client_where,
    )
    meet = _meet(meeting)
    if decision.startswith("skip:"):
        reason = decision.split(":", 1)[1]
        _append_slot(slot, "skip", _with_where("%s;meeting=%s" % (reason, meet), client_where))
        return decision, slot
    if decision == "laptop":
        _append_slot(
            slot, "laptop",
            _with_where("meeting=%s;log_end=%d" % (meet, _log_size()), client_where),
        )
        return "laptop", slot
    return _send_channel("phone", slot, meeting, client_where), slot


def perform_handoff(meeting, slot=None, client_where=None):
    if not _slot_key_ok(slot):
        slot = _slot_now()
    owner, detail = _slot_owner(slot)
    if owner != "laptop":
        return _owner_route(owner, detail), slot, False
    if _handoff_blocked(slot, detail):
        return "laptop", slot, False
    route = _send_channel("handoff", slot, meeting, client_where)
    return route, slot, route == "handoff"


def _last_set():
    last = None
    for cols in _each_log_row():
        if _is_set_row(cols):
            last = cols
    if last is None:
        return ""
    reps = last[2] if len(last) > 2 else ""
    return ("%s x%s" % (last[1], reps)) if reps else last[1]


def slot_status(slot=None):
    # Read-only. The laptop polls this while its dialog is up, so a set
    # logged through the bot or the CLI can take the dialog down.
    if not _slot_key_ok(slot):
        slot = _slot_now()
    owner, detail = _slot_owner(slot)
    logged = owner == "laptop" and _handoff_blocked(slot, detail)
    return {
        "ok": True,
        "slot": slot,
        "route": _owner_route(owner, detail),
        "logged": logged,
        "what": _last_set() if logged else "",
    }


def perform_answered(how, slot=None):
    if how not in ("log", "skip", "snooze", "off", "elsewhere"):
        how = "log"
    if not _slot_key_ok(slot):
        slot = _slot_now()
    owner, _detail = _slot_owner(slot)
    # The dialog was shown because the hub was down, so nothing owns the hour.
    # Claiming it here stops the :22/:52 job from phoning a second ping for a
    # slot the person already answered.
    if owner is None:
        _append_slot(slot, "laptop", "meeting=0;log_end=%d" % _log_size())
    _append_slot(slot, "answered", how)
    return "answered", slot


def _route_body(route, slot, sent=None):
    body = {"ok": True, "route": route, "slot": slot}
    if sent is not None:
        body["sent"] = sent
    return 200, body


def api_route(query, body):
    body = as_dict(body)
    device = body.get("device")
    if device not in ("laptop", "hub"):
        return 400, {"ok": False, "output": "", "error": "device must be laptop or hub"}
    client_where = _posted_where(body)
    if client_where is False:
        return 400, {"ok": False, "output": "", "error": "where must be home or away"}
    idle = None
    if device == "laptop" and "idle" in body and body.get("idle") is not None:
        idle = decimal(body.get("idle"))
        if idle is None:
            return 400, {"ok": False, "output": "", "error": "idle must be a number"}
    meeting = body.get("meeting") is True
    with WRITE_LOCK:
        route, slot = perform_route(idle, meeting, client_where)
    return _route_body(route, slot)


def api_route_handoff(query, body):
    body = as_dict(body)
    client_where = _posted_where(body)
    if client_where is False:
        return 400, {"ok": False, "output": "", "error": "where must be home or away"}
    meeting = body.get("meeting") is True
    slot = body.get("slot") if isinstance(body.get("slot"), str) else None
    with WRITE_LOCK:
        route, slot, sent = perform_handoff(meeting, slot, client_where)
    return _route_body(route, slot, sent)


def api_route_answered(query, body):
    body = as_dict(body)
    how = body.get("how") if isinstance(body.get("how"), str) else "log"
    slot = body.get("slot") if isinstance(body.get("slot"), str) else None
    with WRITE_LOCK:
        route, slot = perform_answered(how, slot)
    return _route_body(route, slot)


def api_route_status(query, body):
    body = as_dict(body)
    slot = body.get("slot") if isinstance(body.get("slot"), str) else None
    return 200, slot_status(slot)


def schema(name, description, properties, required=None):
    spec = {"type": "object", "properties": properties}
    if required:
        spec["required"] = required
    return {"name": name, "description": description, "inputSchema": spec}


# One table, two transports. HTTP routes and MCP tools both call these.
TOOLS = {
    "log_sets": (
        schema(
            "log_sets",
            "Log a set or a round. text is like `pull-ups x5 and dead hang 30s` "
            "(and, ; or | between sets; a comma stays in the name). "
            "at is when it happened, like `7:15` or `yesterday 7am`; the @ is added for you. "
            "new=true logs a name that was just refused, as typed.",
            {"text": {"type": "string"}, "at": {"type": "string"}, "new": {"type": "boolean"}},
            ["text"],
        ),
        log_sets,
    ),
    "get_summary": (
        schema(
            "get_summary",
            "Read the log. period is today, week, history, stats, or status. "
            "days limits history (default 30).",
            {"period": {"type": "string"}, "days": {"type": "integer"}},
            ["period"],
        ),
        get_summary,
    ),
    "list_movements": (
        schema(
            "list_movements",
            "Today's options plus all-time totals (`gtg options` and `gtg stats`). "
            "There is no separate known-movement command.",
            {},
        ),
        list_movements,
    ),
    "pause": (
        schema(
            "pause",
            "Stop the nudges. for is `2h` or `3d`; leave it out for the rest of today. "
            "reason is a short note like `sick`.",
            {"for": {"type": "string"}, "reason": {"type": "string"}},
        ),
        pause,
    ),
    "resume": (
        schema(
            "resume",
            "Turn the nudges back on.",
            {},
        ),
        resume,
    ),
}


def rpc_ok(req_id, result):
    return {"jsonrpc": "2.0", "id": req_id, "result": result}


def rpc_err(req_id, code, message):
    return {"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": message}}


def tool_result(payload):
    lines = []
    if payload.get("output"):
        lines.append(payload["output"].rstrip("\n"))
    if payload.get("error"):
        lines.append(payload["error"].rstrip("\n"))
    if payload.get("known"):
        lines.append("known:\n" + payload["known"].rstrip("\n"))
    return {
        "content": [{"type": "text", "text": "\n".join(lines)}],
        "isError": not payload.get("ok"),
    }


def rpc_initialize(req_id, params):
    params = as_dict(params)
    asked = params.get("protocolVersion")
    version = asked if asked in PROTOCOLS else DEFAULT_PROTOCOL
    return rpc_ok(req_id, {
        "protocolVersion": version,
        "capabilities": {"tools": {}},
        "serverInfo": {"name": "gtg", "version": "1"},
    })


def rpc_ping(req_id, params):
    return rpc_ok(req_id, {})


def rpc_tools_list(req_id, params):
    return rpc_ok(req_id, {"tools": [TOOLS[name][0] for name in TOOLS]})


def rpc_tools_call(req_id, params):
    params = as_dict(params)
    name = params.get("name")
    pair = TOOLS.get(name)
    if pair is None:
        return rpc_err(req_id, -32602, "unknown tool: %s" % name)
    arguments = params.get("arguments")
    if arguments is None:
        arguments = {}
    if not isinstance(arguments, dict):
        return rpc_err(req_id, -32602, "arguments must be an object")
    _status, payload = pair[1](arguments)
    return rpc_ok(req_id, tool_result(payload))


RPC = {
    "initialize": rpc_initialize,
    "ping": rpc_ping,
    "tools/list": rpc_tools_list,
    "tools/call": rpc_tools_call,
}


def split_path(raw):
    parts = urlsplit(raw)
    path = parts.path or "/"
    if path == "/gtg":
        path = "/"
    elif path.startswith("/gtg/"):
        path = path[4:] or "/"
    if len(path) > 1 and path.endswith("/"):
        path = path[:-1]
    return path, parse_qs(parts.query)


def q_first(query, key):
    vals = query.get(key)
    if not vals:
        return None
    return vals[0]


def needs_auth(path):
    return path == "/mcp" or path.startswith("/api/")


def authorized(header):
    if not header:
        return False
    parts = header.split(None, 1)
    if len(parts) != 2 or parts[0].lower() != "bearer":
        return False
    return hmac.compare_digest(parts[1], TOKEN)



# --- Oura readiness / sleep / activity --------------------------------------
# Personal OAuth (authorization code + refresh). Client secrets stay in
# ~/.config/gtg/oura-client.json; tokens in oura-tokens.json. The energy
# snapshot for the bot is cached under STATE_DIR so /api/energy stays cheap.


def oura_api_base():
    return (os.environ.get("GTG_OURA_API") or "https://api.ouraring.com").rstrip("/")


def oura_auth_base():
    return (os.environ.get("GTG_OURA_AUTH") or "https://cloud.ouraring.com").rstrip("/")


def oura_client_path():
    return os.path.join(CONF_DIR, "oura-client.json")


def oura_tokens_path():
    return os.path.join(CONF_DIR, "oura-tokens.json")


def oura_energy_path():
    return os.path.join(STATE_DIR, "oura-energy.json")


def oura_write_private(path, text):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, text.encode("utf-8"))
    finally:
        os.close(fd)
    os.chmod(path, 0o600)


def oura_read_json(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except OSError:
        return None, "cannot read %s" % path
    except ValueError:
        return None, "not json"
    if not isinstance(data, dict):
        return None, "not json"
    return data, ""


def oura_load_client():
    data, err = oura_read_json(oura_client_path())
    if err:
        return None, "oura client not configured; Ben needs ~/.config/gtg/oura-client.json on the hub"
    for field in ("client_id", "client_secret", "redirect_uri"):
        val = data.get(field)
        if not isinstance(val, str) or not val.strip():
            return None, "oura client missing %s" % field
    return {
        "client_id": data["client_id"].strip(),
        "client_secret": data["client_secret"].strip(),
        "redirect_uri": data["redirect_uri"].strip(),
    }, ""


def oura_load_tokens():
    data, err = oura_read_json(oura_tokens_path())
    if err or not data:
        return None
    access = data.get("access_token")
    refresh = data.get("refresh_token")
    if not isinstance(access, str) or not access:
        return None
    if not isinstance(refresh, str) or not refresh:
        return None
    return data


def oura_save_tokens(payload):
    # Never log this. Mode 600 only.
    oura_write_private(oura_tokens_path(), json.dumps(payload, indent=2, sort_keys=True) + "\n")


def oura_now_local():
    from datetime import datetime, timezone
    try:
        return datetime.now(ZoneInfo(OURA_TZ))
    except ZoneInfoNotFoundError:
        return datetime.now(timezone.utc)


def oura_today_date():
    return oura_now_local().date().isoformat()


def oura_iso_now():
    dt = oura_now_local()
    return dt.replace(microsecond=0).isoformat()


def oura_b64url(raw):
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")


def oura_pkce():
    verifier = secrets.token_urlsafe(64)
    if len(verifier) > 128:
        verifier = verifier[:128]
    challenge = oura_b64url(hashlib.sha256(verifier.encode("ascii")).digest())
    return verifier, challenge


def oura_http(method, url, headers=None, body=None, form=None):
    if form is not None:
        data = urlencode(form).encode("utf-8")
        headers = dict(headers or {})
        headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
    elif body is not None:
        data = body if isinstance(body, bytes) else body.encode("utf-8")
        headers = dict(headers or {})
    else:
        data = None
        headers = dict(headers or {})
    req = urllib.request.Request(url, data=data, method=method)
    for key, value in headers.items():
        req.add_header(key, value)
    try:
        resp = OURA_OPENER.open(req, timeout=20)
        try:
            code = resp.getcode()
            raw = resp.read()
        finally:
            resp.close()
    except urllib.error.HTTPError as exc:
        try:
            raw = exc.read()
        except Exception:
            raw = b""
        try:
            exc.close()
        except Exception:
            pass
        return exc.code, raw
    except (urllib.error.URLError, socket.timeout, TimeoutError, OSError):
        return 0, b""
    return code, raw


def oura_json_http(method, url, headers=None, form=None):
    code, raw = oura_http(method, url, headers=headers, form=form)
    if code == 0:
        return 0, None, "network error talking to Oura"
    try:
        data = json.loads(raw.decode("utf-8")) if raw else None
    except (ValueError, UnicodeDecodeError):
        return code, None, "Oura response was not json"
    return code, data, ""


def oura_store_oauth_tokens(data, prior=None):
    prior = prior or {}
    access = data.get("access_token")
    refresh = data.get("refresh_token") or prior.get("refresh_token")
    if not isinstance(access, str) or not access:
        return "token response had no access_token"
    if not isinstance(refresh, str) or not refresh:
        return "token response had no refresh_token"
    try:
        expires_in = int(data.get("expires_in") or 86400)
    except (TypeError, ValueError):
        expires_in = 86400
    scope = data.get("scope") or prior.get("scope") or OURA_SCOPE
    if not isinstance(scope, str):
        scope = OURA_SCOPE
    payload = {
        "access_token": access,
        "refresh_token": refresh,
        "expires_at": int(time.time()) + max(expires_in, 60),
        "scope": scope,
        "token_type": data.get("token_type") or "bearer",
    }
    oura_save_tokens(payload)
    return ""


def oura_refresh_access(client, tokens):
    code, data, err = oura_json_http(
        "POST",
        oura_api_base() + "/oauth/token",
        form={
            "grant_type": "refresh_token",
            "refresh_token": tokens["refresh_token"],
            "client_id": client["client_id"],
            "client_secret": client["client_secret"],
        },
    )
    if err:
        return None, err
    if code != 200 or not isinstance(data, dict):
        return None, "Oura token refresh failed (%s)" % (code or "network")
    err = oura_store_oauth_tokens(data, tokens)
    if err:
        return None, err
    return oura_load_tokens(), ""


def oura_access(client, force_refresh=False):
    tokens = oura_load_tokens()
    if tokens is None:
        return None, "oura not connected; ask Ben to open the authorize URL from GET /api/oura/authorize"
    expires_at = tokens.get("expires_at")
    stale = True
    if isinstance(expires_at, (int, float)) and not isinstance(expires_at, bool):
        stale = time.time() >= float(expires_at) - 60
    if force_refresh or stale:
        tokens, err = oura_refresh_access(client, tokens)
        if err:
            return None, err
    return tokens, ""


def oura_get_collection(tokens, name, start_date, end_date):
    qs = urlencode({"start_date": start_date, "end_date": end_date})
    url = "%s/v2/usercollection/%s?%s" % (oura_api_base(), name, qs)
    code, data, err = oura_json_http(
        "GET", url, headers={"Authorization": "Bearer " + tokens["access_token"]}
    )
    if err:
        return None, err
    if code == 401:
        return None, "oura unauthorized"
    if code != 200 or not isinstance(data, dict):
        return None, "Oura %s failed (%s)" % (name, code or "network")
    rows = data.get("data")
    if not isinstance(rows, list):
        rows = []
    return rows, ""


def oura_pick_day(rows, day):
    best = None
    for row in rows:
        if not isinstance(row, dict):
            continue
        if row.get("day") == day:
            best = row
    return best


def oura_score(row):
    if not isinstance(row, dict):
        return None
    score = row.get("score")
    if isinstance(score, bool) or not isinstance(score, (int, float)):
        return None
    return int(score)


def oura_contributors(row):
    if not isinstance(row, dict):
        return {}
    raw = row.get("contributors")
    if not isinstance(raw, dict):
        return {}
    out = {}
    for key, value in raw.items():
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            continue
        out[str(key)] = int(value)
    return out


def oura_sleep_hours_and_efficiency(sleep_rows, day):
    hours = 0.0
    found = False
    efficiency = None
    for row in sleep_rows or []:
        if not isinstance(row, dict):
            continue
        if row.get("day") != day:
            continue
        dur = row.get("total_sleep_duration")
        if isinstance(dur, bool) or not isinstance(dur, (int, float)):
            continue
        hours += float(dur) / 3600.0
        found = True
        eff = row.get("efficiency")
        if not isinstance(eff, bool) and isinstance(eff, (int, float)):
            efficiency = int(eff)
    if not found:
        return None, efficiency
    return round(hours, 2), efficiency


def oura_rest_mode_active(rows, day):
    for row in rows or []:
        if not isinstance(row, dict):
            continue
        start = row.get("start_day")
        end = row.get("end_day")
        if not isinstance(start, str) or start > day:
            continue
        if end is None or end == "" or (isinstance(end, str) and end >= day):
            return True
    return False


def oura_coaching(readiness_score, rest_mode):
    if readiness_score is None:
        band = "unknown"
        note = "No readiness score yet today; coach from how Ben feels, not invented numbers."
    elif readiness_score >= 85:
        band = "high"
        note = "Readiness is high; a normal or harder day of sets is fine."
    elif readiness_score >= 70:
        band = "moderate"
        note = "Readiness is moderate; keep the usual plan and watch for fatigue."
    else:
        band = "low"
        note = "Readiness is low; prefer lighter options and recovery over pushing volume."
    if rest_mode:
        note = "Rest Mode is on in Oura. " + note
    return {"band": band, "note": note}


def oura_empty_energy(day, connected, error):
    return {
        "ok": False,
        "date": day,
        "timezone": OURA_TZ,
        "as_of": oura_iso_now(),
        "source": "oura",
        "connected": connected,
        "readiness": {"score": None, "contributors": {}},
        "sleep": {"score": None, "total_sleep_hours": None, "efficiency": None},
        "activity": {"score": None},
        "coaching": {
            "band": "unknown",
            "note": (
                "Oura is not connected. Ask Ben to connect via /api/oura/status "
                "then open the URL from /api/oura/authorize."
                if not connected
                else "Energy data unavailable; do not invent scores."
            ),
        },
        "error": error,
    }


def oura_build_energy(tokens):
    day = oura_today_date()
    readiness_rows, err = oura_get_collection(tokens, "daily_readiness", day, day)
    if err:
        return None, err
    sleep_daily, err = oura_get_collection(tokens, "daily_sleep", day, day)
    if err:
        return None, err
    activity_rows, err = oura_get_collection(tokens, "daily_activity", day, day)
    if err:
        return None, err
    # Detailed sleep periods carry duration/efficiency; daily scope covers them.
    sleep_periods, sleep_err = oura_get_collection(tokens, "sleep", day, day)
    if sleep_err:
        sleep_periods = []
    rest_rows, rest_err = oura_get_collection(tokens, "rest_mode_period", day, day)
    if rest_err:
        rest_rows = []
    ready = oura_pick_day(readiness_rows, day)
    sleep = oura_pick_day(sleep_daily, day)
    activity = oura_pick_day(activity_rows, day)
    r_score = oura_score(ready)
    s_score = oura_score(sleep)
    a_score = oura_score(activity)
    hours, efficiency = oura_sleep_hours_and_efficiency(sleep_periods, day)
    if efficiency is None:
        contrib = oura_contributors(sleep)
        if "efficiency" in contrib:
            efficiency = contrib["efficiency"]
    rest_mode = oura_rest_mode_active(rest_rows, day)
    payload = {
        "ok": True,
        "date": day,
        "timezone": OURA_TZ,
        "as_of": oura_iso_now(),
        "source": "oura",
        "connected": True,
        "readiness": {"score": r_score, "contributors": oura_contributors(ready)},
        "sleep": {
            "score": s_score,
            "total_sleep_hours": hours,
            "efficiency": efficiency,
        },
        "activity": {"score": a_score},
        "coaching": oura_coaching(r_score, rest_mode),
        "error": None,
    }
    if rest_mode:
        payload["rest_mode"] = True
    return payload, ""


def oura_save_energy(payload):
    oura_write_private(oura_energy_path(), json.dumps(payload, indent=2, sort_keys=True) + "\n")


def oura_load_energy_cache():
    data, err = oura_read_json(oura_energy_path())
    if err or not data:
        return None
    return data


def oura_cache_fresh(payload):
    if not isinstance(payload, dict) or not payload.get("ok"):
        return False
    if payload.get("date") != oura_today_date():
        return False
    as_of = payload.get("as_of")
    if not isinstance(as_of, str) or not as_of:
        return False
    try:
        from datetime import datetime
        stamp = datetime.fromisoformat(as_of)
        if stamp.tzinfo is None:
            stamp = stamp.replace(tzinfo=ZoneInfo(OURA_TZ))
        age = (oura_now_local() - stamp.astimezone(ZoneInfo(OURA_TZ))).total_seconds()
    except Exception:
        return False
    return 0 <= age <= OURA_CACHE_TTL


def oura_pull_energy(force=False):
    client, err = oura_load_client()
    if err:
        day = oura_today_date()
        return 200, oura_empty_energy(day, False, err)
    tokens, err = oura_access(client, force_refresh=force)
    if err:
        day = oura_today_date()
        return 200, oura_empty_energy(day, False, err)
    if not force:
        cached = oura_load_energy_cache()
        if oura_cache_fresh(cached):
            return 200, cached
    payload, err = oura_build_energy(tokens)
    if err:
        # One retry after a forced refresh if the access token was rejected.
        if "unauthorized" in err:
            tokens, refresh_err = oura_access(client, force_refresh=True)
            if not refresh_err:
                payload, err = oura_build_energy(tokens)
        if err:
            day = oura_today_date()
            body = oura_empty_energy(day, True, err)
            return 200, body
    oura_save_energy(payload)
    return 200, payload


def oura_token_expiry_class(tokens):
    if not tokens:
        return "none"
    expires_at = tokens.get("expires_at")
    if isinstance(expires_at, bool) or not isinstance(expires_at, (int, float)):
        return "unknown"
    left = float(expires_at) - time.time()
    if left <= 0:
        return "expired"
    if left <= 3600:
        return "expiring"
    return "valid"


def oura_scopes_list(tokens):
    if not tokens:
        return []
    scope = tokens.get("scope") or ""
    if not isinstance(scope, str):
        return []
    return [part for part in scope.replace(",", " ").split() if part]


def api_oura_status(query, body):
    client, client_err = oura_load_client()
    tokens = oura_load_tokens()
    cached = oura_load_energy_cache()
    last_pull = None
    last_error = None
    if isinstance(cached, dict):
        if isinstance(cached.get("as_of"), str):
            last_pull = cached.get("as_of")
        if cached.get("error"):
            last_error = cached.get("error")
    configured = client is not None
    connected = configured and tokens is not None
    payload = {
        "ok": True,
        "configured": configured,
        "connected": connected,
        "scopes": oura_scopes_list(tokens) if connected else [],
        "token_expiry": oura_token_expiry_class(tokens),
        "last_pull": last_pull,
        "error": None if configured else client_err,
    }
    if configured and not connected:
        payload["error"] = "oura not connected; GET /api/oura/authorize and open authorize_url"
    if connected and last_error and not cached.get("ok"):
        payload["error"] = last_error
    return 200, payload


def api_oura_authorize(query, body):
    client, err = oura_load_client()
    if err:
        return 400, {"ok": False, "authorize_url": None, "error": err}
    state = secrets.token_urlsafe(24)
    verifier, challenge = oura_pkce()
    with OURA_LOCK:
        # Drop expired states while we are here.
        now = time.time()
        dead = [k for k, v in OURA_STATES.items() if v.get("expires", 0) < now]
        for k in dead:
            OURA_STATES.pop(k, None)
        OURA_STATES[state] = {
            "expires": now + OURA_STATE_TTL,
            "code_verifier": verifier,
        }
    qs = urlencode({
        "response_type": "code",
        "client_id": client["client_id"],
        "redirect_uri": client["redirect_uri"],
        "scope": OURA_SCOPE,
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
    })
    url = "%s/oauth/authorize?%s" % (oura_auth_base(), qs)
    return 200, {"ok": True, "authorize_url": url, "error": None}


def oura_callback_html(ok, message):
    title = "gtg oura" if ok else "gtg oura failed"
    color = "#0a0" if ok else "#a00"
    body = (
        "<!doctype html><html><head><meta charset=\"utf-8\">"
        "<title>%s</title></head><body style=\"font-family:system-ui;padding:2rem\">"
        "<h1 style=\"color:%s\">%s</h1><p>%s</p>"
        "<p>You can close this tab.</p></body></html>"
    ) % (
        title,
        color,
        "Oura connected" if ok else "Oura connect failed",
        message,
    )
    return body.encode("utf-8")


def oura_exchange_code(client, code, code_verifier):
    form = {
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": client["redirect_uri"],
        "client_id": client["client_id"],
        "client_secret": client["client_secret"],
    }
    if code_verifier:
        form["code_verifier"] = code_verifier
    code_status, data, err = oura_json_http(
        "POST", oura_api_base() + "/oauth/token", form=form
    )
    if err:
        return err
    if code_status != 200 or not isinstance(data, dict):
        return "Oura code exchange failed (%s)" % (code_status or "network")
    return oura_store_oauth_tokens(data)


def handle_oura_callback(query):
    err_param = q_first(query, "error")
    if err_param:
        detail = q_first(query, "error_description") or err_param
        return 400, oura_callback_html(False, "Authorization denied: %s" % detail)
    state = q_first(query, "state")
    code = q_first(query, "code")
    if not state or not code:
        return 400, oura_callback_html(False, "Missing code or state.")
    with OURA_LOCK:
        entry = OURA_STATES.pop(state, None)
    if entry is None or entry.get("expires", 0) < time.time():
        return 400, oura_callback_html(False, "State expired or unknown. Ask for a new authorize URL.")
    client, err = oura_load_client()
    if err:
        return 500, oura_callback_html(False, err)
    err = oura_exchange_code(client, code, entry.get("code_verifier"))
    if err:
        return 502, oura_callback_html(False, err)
    # Best-effort first pull so /api/energy is warm.
    try:
        oura_pull_energy(force=True)
    except Exception:
        pass
    return 200, oura_callback_html(True, "Tokens saved on the hub. The GTG bot can read /api/energy.")


def api_oura_refresh(query, body):
    client, err = oura_load_client()
    if err:
        return 400, {"ok": False, "error": err}
    tokens, err = oura_access(client, force_refresh=True)
    if err:
        return 400, {"ok": False, "error": err}
    status, payload = oura_pull_energy(force=True)
    return status, payload


def api_energy(query, body):
    return oura_pull_energy(force=False)


def api_summary(query, body):
    return get_summary({"period": q_first(query, "period"), "days": q_first(query, "days")})


def api_movements(query, body):
    return list_movements({})


def api_log(query, body):
    return log_sets(body)


def api_off(query, body):
    return pause(body)


def api_on(query, body):
    return resume(body)


def _plan_date(raw):
    if not isinstance(raw, str) or len(raw) != 10:
        return False
    try:
        return date.fromisoformat(raw).isoformat() == raw
    except ValueError:
        return False


def _known_plan_movements():
    proc = subprocess.run(
        ['/bin/bash', '-c', 'source "$1"; known_movements', '_',
         os.path.join(HERE, 'gtg-lib.sh')],
        capture_output=True, text=True, env=os.environ.copy(), timeout=15,
    )
    if proc.returncode != 0:
        raise OSError('could not read known movements')
    return sorted({line.split('\t', 1)[1] for line in proc.stdout.splitlines() if '\t' in line})


def _validate_plan(body, known):
    if not _plan_date(body.get('date')):
        raise ValueError('date must be YYYY-MM-DD and a valid calendar date')
    for key in ('readiness', 'sleep'):
        if type(body.get(key)) is not int or not 0 <= body[key] <= 100:
            raise ValueError('%s must be an integer from 0 to 100' % key)
    if body.get('band') not in ('low', 'moderate', 'high'):
        raise ValueError('band must be low, moderate, or high')
    if not isinstance(body.get('note'), str):
        raise ValueError('note must be a string')
    if not isinstance(body.get('slots'), list) or not isinstance(body.get('targets'), dict):
        raise ValueError('slots must be an array and targets an object')
    names = {name.casefold(): name for name in known}
    unknown = []

    def movement(raw):
        if not isinstance(raw, str) or not raw.strip():
            raise ValueError('movement must be a nonempty string')
        canonical = names.get(raw.casefold())
        if canonical is None:
            unknown.append(raw)
        return canonical or raw

    slots, hours = [], set()
    for slot in body['slots']:
        if not isinstance(slot, dict) or type(slot.get('hour')) is not int or not 0 <= slot['hour'] <= 23:
            raise ValueError('each slot needs an integer hour from 0 to 23')
        if slot['hour'] in hours:
            raise ValueError('slot hours must be unique')
        hours.add(slot['hour'])
        if not isinstance(slot.get('why', ''), str):
            raise ValueError('why must be a string')
        if not isinstance(slot.get('items'), list) or not slot['items']:
            raise ValueError('each slot needs a nonempty items array')
        items = []
        for item in slot['items']:
            if not isinstance(item, dict):
                raise ValueError('each item must be an object')
            metrics = [key for key in ('reps', 'seconds') if key in item]
            if len(metrics) != 1 or type(item[metrics[0]]) is not int or item[metrics[0]] <= 0:
                raise ValueError('each item needs exactly one positive integer: reps or seconds')
            metric = metrics[0]
            items.append({'movement': movement(item.get('movement')), metric: item[metric]})
        slots.append({'hour': slot['hour'], 'items': items, 'why': slot.get('why', '')})
    targets = {}
    for name, count in body['targets'].items():
        if type(count) is not int or count <= 0:
            raise ValueError('each target must be a positive integer')
        canonical = movement(name)
        if canonical in targets:
            raise ValueError('duplicate target movement')
        targets[canonical] = count
    if unknown:
        return None, unknown
    return {key: body[key] for key in ('date', 'readiness', 'sleep', 'band', 'note')} | {
        'slots': sorted(slots, key=lambda slot: slot['hour']), 'targets': targets}, []


def api_plan_post(query, body):
    try:
        with WRITE_LOCK:
            known = _known_plan_movements()
            plan, unknown = _validate_plan(body, known)
            if unknown:
                return 422, {'ok': False, 'error': 'unknown movement: ' + ', '.join(unknown), 'known': known}
            directory = os.path.join(STATE_DIR, 'plans')
            os.makedirs(directory, exist_ok=True)
            path = os.path.join(directory, plan['date'] + '.json')
            temporary = None
            try:
                with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=directory, delete=False) as fh:
                    temporary = fh.name
                    json.dump(plan, fh)
                    fh.flush()
                    os.fsync(fh.fileno())
                os.replace(temporary, path)
            finally:
                if temporary and os.path.exists(temporary):
                    os.unlink(temporary)
            return 200, {'ok': True, 'plan': plan}
    except ValueError as exc:
        return 400, {'ok': False, 'error': str(exc)}
    except (OSError, subprocess.TimeoutExpired):
        return 500, {'ok': False, 'error': 'could not store plan'}


def _plan_progress(day):
    try:
        with open(os.path.join(STATE_DIR, 'plans', day + '.json'), encoding='utf-8') as fh:
            plan = json.load(fh)
    except FileNotFoundError:
        return {'ok': True, 'plan': None, 'progress': None}
    try:
        names = list(plan['targets']) + [item['movement'] for slot in plan['slots'] for item in slot['items']]
        plan, _unknown = _validate_plan(plan, names)
    except (KeyError, TypeError, AttributeError):
        raise ValueError('invalid saved plan') from None
    states, totals = {}, {}
    duration_names = {item['movement'].casefold() for slot in plan['slots']
                      for item in slot['items'] if 'seconds' in item}
    for cols in _each_log_row():
        if len(cols) < 3 or not cols[0].startswith(day + 'T'):
            continue
        key = cols[0][:13]
        if not _is_set_row(cols):
            if states.get(key) != 'done':
                states[key] = 'skipped'
            continue
        states[key] = 'done'
        name = cols[1].casefold()
        raw = (cols[5] if len(cols) > 5 else '') if name in duration_names else cols[2]
        if raw.isdigit():
            totals[name] = totals.get(name, 0) + int(raw)
    try:
        with open(_slots_path(), encoding='utf-8') as fh:
            for line in fh:
                cols = line.rstrip('\n').split('\t')
                if len(cols) < 4 or not cols[1].startswith(day + 'T'):
                    continue
                key, event, how = cols[1:4]
                if event == 'answered' and how in ('log', 'elsewhere'):
                    states[key] = 'done'
                elif states.get(key) != 'done' and (event == 'skip' or (event == 'answered' and how in ('skip', 'off'))):
                    states[key] = 'skipped'
    except FileNotFoundError:
        pass
    for slot in plan['slots']:
        slot['status'] = states.get('%sT%02d' % (day, slot['hour']), 'pending')
    targets = {name: {'done': totals.get(name.casefold(), 0), 'target': target,
                      'remaining': max(0, target - totals.get(name.casefold(), 0))}
               for name, target in plan['targets'].items()}
    return {'ok': True, 'plan': plan, 'progress': {'targets': targets}}


def api_plan_get(query, body):
    day = q_first(query, 'date')
    if day is None:
        day = _slot_now()[:10]
    if not _plan_date(day):
        return 400, {'ok': False, 'error': 'date must be YYYY-MM-DD and a valid calendar date'}
    try:
        return 200, _plan_progress(day)
    except (OSError, ValueError):
        return 500, {'ok': False, 'error': 'could not read plan progress'}


def _plan_next():
    now = _slot_now()
    result = _plan_progress(now[:10])
    plan = result['plan']
    slot = next((slot for slot in plan['slots'] if slot['status'] == 'pending' and slot['hour'] >= int(now[11:13])), None) if plan else None
    return {'ok': True, 'plan': plan, 'slot': '%sT%02d' % (now[:10], slot['hour']) if slot else None,
            'items': slot['items'] if slot else [], 'why': slot['why'] if slot else '',
            'note': plan['note'] if plan else '',
            'remaining_targets': {name: value['remaining'] for name, value in result['progress']['targets'].items()} if plan else {}}


def api_plan_next(query, body):
    try:
        return 200, _plan_next()
    except (OSError, ValueError):
        return 500, {'ok': False, 'error': 'could not read plan progress'}


API = {
    ("POST", "/api/plan"): api_plan_post,
    ("GET", "/api/plan"): api_plan_get,
    ("GET", "/api/plan/next"): api_plan_next,
    ("GET", "/api/summary"): api_summary,
    ("GET", "/api/movements"): api_movements,
    ("POST", "/api/log"): api_log,
    ("POST", "/api/off"): api_off,
    ("POST", "/api/on"): api_on,
    ("POST", "/api/route"): api_route,
    ("POST", "/api/route/handoff"): api_route_handoff,
    ("POST", "/api/route/answered"): api_route_answered,
    ("POST", "/api/route/status"): api_route_status,
    ("GET", "/api/oura/status"): api_oura_status,
    ("GET", "/api/oura/authorize"): api_oura_authorize,
    ("POST", "/api/oura/refresh"): api_oura_refresh,
    ("GET", "/api/energy"): api_energy,
}


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        sys.stderr.write("gtg-server: " + (fmt % args) + "\n")

    def do_GET(self):
        self.route("GET")

    def do_POST(self):
        self.route("POST")

    def do_PUT(self):
        self.route("PUT")

    def do_DELETE(self):
        self.route("DELETE")

    def route(self, method):
        path, query = split_path(self.path)
        kind, body = "EMPTY", {}
        if method == "POST":
            kind, body = self.read_json()
            if kind == "TOO_BIG":
                self.send_json(413, {"ok": False, "output": "", "error": "body too large"}, close=True)
                return
        if needs_auth(path) and not authorized(self.headers.get("Authorization")):
            self.send_json(401, {"ok": False, "output": "", "error": "unauthorized"}, authenticate=True)
            return
        if kind == "BAD":
            self.send_json(400, {"ok": False, "output": "", "error": "bad json"})
            return
        if method == "GET" and path == "/":
            self.dashboard()
            return
        if method == "GET" and path == "/agent.md":
            self.agent()
            return
        if method == "GET" and path == "/oura/callback":
            status, raw = handle_oura_callback(query)
            self.send_bytes(status, raw, "text/html; charset=utf-8")
            return
        if method == "POST" and path == "/mcp":
            self.mcp(body)
            return
        handler = API.get((method, path))
        if handler is None:
            self.send_json(404, {"ok": False, "output": "", "error": "not found"})
            return
        status, payload = handler(query, body)
        self.send_json(status, payload)

    def content_length(self):
        raw = self.headers.get("Content-Length")
        if raw is None or raw == "":
            return 0
        try:
            n = int(raw)
        except ValueError:
            return None
        if n < 0:
            return None
        return n

    def read_json(self):
        n = self.content_length()
        if n is None:
            return "BAD", None
        if n > MAX_BODY:
            return "TOO_BIG", None
        raw = self.rfile.read(n) if n else b""
        if raw == b"":
            return "EMPTY", {}
        try:
            data = json.loads(raw.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return "BAD", None
        if not isinstance(data, dict):
            return "BAD", None
        return "OK", data

    def send_json(self, status, payload, authenticate=False, close=False):
        raw = json.dumps(payload).encode("utf-8")
        self.send_bytes(status, raw, "application/json; charset=utf-8", authenticate, close)

    def send_bytes(self, status, raw, content_type, authenticate=False, close=False):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(raw)))
        if authenticate:
            self.send_header("WWW-Authenticate", 'Bearer realm="gtg"')
        if close:
            self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(raw)

    def dashboard(self):
        path = os.path.join(STATE_DIR, "history.html")
        with WRITE_LOCK:
            stale = (time.time() - PAGE_AT[0]) >= PAGE_TTL or not os.path.isfile(path)
            if stale:
                proc = subprocess.run(
                    [PAGE, "--no-open"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    env=os.environ.copy(),
                    universal_newlines=True,
                )
                if proc.returncode != 0 or not os.path.isfile(path):
                    err = (proc.stderr or "").strip() or "gtg-page failed"
                    self.send_json(500, {"ok": False, "output": proc.stdout, "error": err})
                    return
                PAGE_AT[0] = time.time()
            with open(path, "rb") as fh:
                data = fh.read()
        self.send_bytes(200, data, "text/html; charset=utf-8")

    def agent(self):
        try:
            with open(AGENT_MD, "rb") as fh:
                data = fh.read()
        except OSError as exc:
            self.send_json(500, {"ok": False, "output": "", "error": "agent.md: %s" % exc})
            return
        self.send_bytes(200, data, "text/markdown; charset=utf-8")

    def mcp(self, msg):
        # read_json already required a dict. An empty body arrives as {}.
        method = msg.get("method")
        if not isinstance(method, str):
            self.send_json(200, rpc_err(msg.get("id"), -32600, "invalid request"))
            return
        if method.startswith("notifications/"):
            self.send_response(202)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        fn = RPC.get(method)
        if fn is None:
            self.send_json(200, rpc_err(msg.get("id"), -32601, "method not found"))
            return
        self.send_json(200, fn(msg.get("id"), msg.get("params")))


class Server(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True


def main():
    global TOKEN
    try:
        sys.stderr.reconfigure(line_buffering=True)
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, OSError):
        pass
    TOKEN = load_token()
    addr = ("127.0.0.1", listen_port())
    try:
        httpd = Server(addr, Handler)
    except OSError as exc:
        die("cannot listen on %s:%s: %s" % (addr[0], addr[1], exc))
    sys.stderr.write("gtg-server: listening on %s:%s\n" % addr)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        httpd.shutdown()


if __name__ == "__main__":
    main()
