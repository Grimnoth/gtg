#!/bin/bash
# gtg -- log a grease-the-groove set. See `gtg help`.
set -u

. "$(dirname "$0")/gtg-lib.sh"

usage() {
  cat <<'EOF'
gtg            log today's first option as done
gtg 12         log 12 reps of that option
gtg "rows x10" log whatever you actually did
gtg options    list today's choices
gtg skip       record a miss
gtg today      today's tally
gtg week       the last 7 days, one line per day
gtg history    the last 30 days (gtg history 90 for more)
gtg stats      totals by exercise, all time
gtg plan       print the current plan
gtg edit       open plan.txt in $EDITOR
EOF
}

where=$(where_am_i)
line=$(primary_option "$where")

case "${1:-done}" in
  help|-h|--help) usage ;;

  plan) cat "$PLAN" ;;

  options) today_options "$where" ;;

  edit) "${EDITOR:-vi}" "$PLAN" ;;

  skip)
    record "$line" "skip" "$where"
    echo "skipped: $line"
    ;;

  today)
    today=$(date '+%Y-%m-%d')
    if [ ! -s "$LOG" ]; then echo "nothing logged yet"; exit 0; fi
    awk -F'\t' -v d="$today" '
      index($1, d) == 1 {
        n++
        if ($3 ~ /^[0-9]+$/) reps += $3
        printf "  %s  %s%s\n", substr($1, 12, 5), $2, ($3 == "skip" ? "  (skipped)" : "")
      }
      END {
        if (n == 0) print "  nothing yet today"
        else printf "\n%d set(s)%s today\n", n, (reps ? ", " reps " reps" : "")
      }' "$LOG"
    ;;

  week)
    if [ ! -s "$LOG" ]; then echo "nothing logged yet"; exit 0; fi
    # Seed the last 7 dates so days with zero sets still print. Silent gaps are
    # the whole point of looking.
    for i in 6 5 4 3 2 1 0; do date -v-"${i}"d '+%Y-%m-%d'; done >"$STATE_DIR/.week"
    awk -F'\t' '
      NR == FNR { order[++k] = $1; seen[$1] = 0; next }
      { d = substr($1, 1, 10); if (d in seen) { seen[d]++; if ($3 == "skip") sk[d]++ } }
      END {
        for (i = 1; i <= k; i++) {
          d = order[i]
          done_n = seen[d] - (d in sk ? sk[d] : 0)
          bar = ""
          for (j = 0; j < done_n; j++) bar = bar "#"
          printf "%s  %-14s %d\n", d, bar, done_n
        }
      }' "$STATE_DIR/.week" "$LOG"
    rm -f "$STATE_DIR/.week"
    ;;

  history)
    days=${2:-30}
    if [ ! -s "$LOG" ]; then echo "nothing logged yet"; exit 0; fi
    i=$(( days - 1 ))
    while [ "$i" -ge 0 ]; do date -v-"${i}"d '+%Y-%m-%d'; i=$(( i - 1 )); done >"$STATE_DIR/.range"
    awk -F'\t' '
      NR == FNR { order[++k] = $1; seen[$1] = 0; next }
      { d = substr($1, 1, 10)
        if (d in seen) { if ($3 == "skip") sk[d]++; else seen[d]++ } }
      END {
        total = 0; active = 0
        for (i = 1; i <= k; i++) {
          d = order[i]; n = seen[d]
          total += n; if (n > 0) active++
          bar = ""
          for (j = 0; j < n; j++) bar = bar "#"
          printf "%s  %-20s %s%s\n", d, bar, (n ? n : "."), \
                 (d in sk ? "  (" sk[d] " skipped)" : "")
        }
        printf "\n%d sets over %d days, %d day(s) active (%d%%)\n", \
               total, k, active, (k ? active * 100 / k : 0)
      }' "$STATE_DIR/.range" "$LOG"
    rm -f "$STATE_DIR/.range"
    ;;

  stats)
    if [ ! -s "$LOG" ]; then echo "nothing logged yet"; exit 0; fi
    awk -F'\t' '
      $3 != "skip" { c[$2]++; if ($3 ~ /^[0-9]+$/) r[$2] += $3 }
      $3 == "skip" { s[$2]++ }
      END {
        for (e in c) printf "%6d|%s\n", c[e], e
        for (e in s) if (!(e in c)) printf "%6d|%s\n", 0, e
      }' "$LOG" | sort -rn | while IFS='|' read -r n e; do
        reps=$(awk -F'\t' -v e="$e" '$2==e && $3 ~ /^[0-9]+$/ {t+=$3} END{print t+0}' "$LOG")
        if [ "$reps" -gt 0 ]; then
          printf "  %-30s %3d sets  %5d reps\n" "$e" "$n" "$reps"
        else
          printf "  %-30s %3d sets\n" "$e" "$n"
        fi
      done
    echo
    awk -F'\t' 'END{print "  " NR " entries since " }' "$LOG" | tr -d '\n'
    head -1 "$LOG" | cut -c1-10
    ;;

  done)
    record "$line" "$(reps_from_line "$line")" "$where"
    echo "logged: $line  [$where]"
    ;;

  *)
    if printf '%s' "$1" | grep -qE '^[0-9]+$'; then
      record "$line" "$1" "$where"
      echo "logged: $line -> $1 reps  [$where]"
    else
      # Anything else is whatever you actually did: gtg "chin-ups x8"
      record "$1" "$(reps_from_line "$1")" "$where"
      echo "logged: $1  [$where]"
    fi
    ;;
esac
