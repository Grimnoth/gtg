#!/bin/bash
# gtg -- log a grease-the-groove set. See `gtg help`.
set -u

. "$(dirname "$0")/gtg-lib.sh"

usage() {
  cat <<'EOF'
gtg            log today's first option as done
gtg 12         log 12 reps of that option
gtg "rows x10" log whatever you actually did
gtg "a; b; c"  log a whole round, ";" between movements

A leading @time logs a set you did EARLIER, which is the point of it -- a
round done before you sat down has nowhere else to go:

gtg @8am 10 ring crunches
gtg @7:15 "pull-ups x5; dead hang 30s"
gtg @-90m push-ups x20          90 minutes ago
gtg @"yesterday 6pm" ring dips x5
gtg when 8am   show how a time would be read, without logging

gtg options    list today's choices
gtg home       count the network you are on now as home
gtg where      home or away, and why
gtg skip       record a miss
gtg add "X"    teach it a new movement (gtg add "swings x10 @ 50 lb" [pool])
gtg backfill   propose splitting old entry names into columns (writes nothing)
gtg today      today's tally
gtg week       the last 7 days, one line per day
gtg history    the last 30 days (gtg history 90 for more)
gtg stats      totals by exercise, all time
gtg page       open the visual history in a browser
gtg plan       print the current plan
gtg edit       open plan.txt in $EDITOR
EOF
}

# A leading "@..." backdates everything after it. Handled once here rather than
# inside each branch, so it composes with the bare form, a rep count and free
# text alike -- `gtg @8am`, `gtg @8am 12`, `gtg @8am "pull-ups x5"`.
if [ $# -gt 0 ] && [ "${1#@}" != "$1" ]; then
  # The whole command line is handed to split_at as one string, so quoting a
  # multi-word time is optional and `gtg @yesterday 7am pull-ups x5` works.
  split_at "$*"
  if [ -z "$AT_ISO" ]; then
    echo "could not read a time out of \"$*\"" >&2
    echo 'try: @8am  @8:00  @14:30  @0730  @-90m  @"yesterday 7am"  @"2026-08-18 6:30"' >&2
    exit 1
  fi
  export GTG_AT="$AT_ISO"
  # What is left is ONE report. With nothing left, `gtg @8am` logs the day's
  # first option at eight.
  if [ -n "$AT_REST" ]; then set -- "$AT_REST"; else set --; fi
fi

# What a backdated write actually landed on. Printed back on every such log,
# because that is what makes a deliberately forgiving time parser safe: a
# misreading is visible in the same breath rather than discovered weeks later
# in the history page.
at_note() {
  [ -n "${GTG_AT:-}" ] || return 0
  printf '  (logged at %s)' \
    "$(date -j -f '%Y-%m-%dT%H:%M:%S' "$GTG_AT" '+%a %-d %b, %-I:%M %p' 2>/dev/null || printf '%s' "$GTG_AT")"
}

where=$(where_am_i)
line=$(primary_option "$where")

case "${1:-done}" in
  help|-h|--help) usage ;;

  plan) cat "$PLAN" ;;

  when)
    # Dry run for the time parser. Writes nothing -- it is here so "what will
    # `@8` mean right now?" is answerable without logging a set to find out.
    if [ -z "${2:-}" ]; then echo 'usage: gtg when 8am' >&2; exit 1; fi
    if ts=$(when_to_iso "${*:2}"); then
      date -j -f '%Y-%m-%dT%H:%M:%S' "$ts" '+%a %-d %b %Y, %-I:%M %p'
    else
      echo "could not read that as a time" >&2; exit 1
    fi
    ;;

  options) today_options "$where" ;;

  page) exec "$(dirname "$0")/gtg-page" "${@:2}" ;;

  home)
    mac=$(current_gateway_mac || true)
    if [ -z "$mac" ]; then
      echo "no gateway visible -- are you on a network?" >&2
      exit 1
    fi
    if grep -qxF "$mac" "$HOME_MAC_FILE" 2>/dev/null; then
      echo "already counted as home: $mac"
    else
      printf '%s\n' "$mac" >>"$HOME_MAC_FILE"
      echo "added as home: $mac"
    fi
    ;;

  where)
    mac=$(current_gateway_mac || true)
    echo "  you are:        $where"
    echo "  this gateway:   ${mac:-none visible}"
    echo "  known as home:"
    if [ -s "$HOME_MAC_FILE" ]; then sed 's/^/    /' "$HOME_MAC_FILE"; else echo "    (none)"; fi
    [ "$where" = away ] && echo "  run 'gtg home' to add this network"
    ;;

  edit) "${EDITOR:-vi}" "$PLAN" ;;

  skip)
    echo "skipped: $(record_option "$line" "$where" skip)"
    ;;

  backfill)
    # One-time repair for rows written before weight and duration had columns
    # of their own, where both were stranded inside the movement name. Opt-in
    # and never automatic, because it rewrites the log; the previous file is
    # kept alongside as log.tsv.bak.
    if [ ! -s "$LOG" ]; then echo "nothing logged yet"; exit 0; fi
    # NEVER writes the live log. It produces a candidate beside it and tells
    # you to move it yourself.
    #
    # This began as an in-place rewrite and each round of review found another
    # way for that to lose data: a redirect that truncated the log before the
    # conversion ran, a failed backup reported as success, a nudge answered
    # mid-migration vanishing between the snapshot and the rename. Those are
    # not three bugs, they are one design -- a destructive rewrite of the only
    # copy of your history, to serve a migration you run once. Handing you a
    # file to inspect and move removes the whole class instead of guarding it.
    rows_before=$(wc -l <"$LOG")
    out="$LOG.migrated"
    awk -F'\t' -v OFS='\t' "$AWK_PARSE"'
      {
        ts = $1; ex = $2; reps = $3; where = $4; wt = $5; dur = $6
        parse(ex)
        # Only touch a row when something UNAMBIGUOUS came out of its name: an
        # explicit "xN", a leading count, a weight, or a duration. A trailing
        # bare number is part of the name at least as often as it is a count,
        # so "Zone 2" keeps both its words -- rewriting it to movement "Zone"
        # with 2 reps would lose a name no backup can tell you was wrong.
        clear = (ex ~ /[xX][0-9]+/ || ex ~ /^[0-9]+[ \t]/ || PW != "" || PD != "")
        if (clear) {
          if (reps == "") reps = PR      # an existing column always wins
          if (wt   == "") wt   = PW
          if (dur  == "") dur  = PD
          if (PN   != "") ex   = PN
        }
        if (ex != $2 || wt != $5 || dur != $6 || reps != $3) n++
        print ts, ex, reps, where, wt, dur
      }
      END { printf "%d\n", n+0 > "/dev/stderr" }
    ' "$LOG" >"$out" 2>"$STATE_DIR/.backfilled" \
      || { rm -f "$out" "$STATE_DIR/.backfilled"; echo "conversion failed; nothing written" >&2; exit 1; }
    rows_after=$(wc -l <"$out")
    changed=$(cat "$STATE_DIR/.backfilled"); rm -f "$STATE_DIR/.backfilled"
    if [ "$rows_after" -ne "$rows_before" ]; then
      rm -f "$out"
      echo "row count changed ($rows_before -> $rows_after); nothing written" >&2
      exit 1
    fi
    if [ "$changed" -eq 0 ]; then
      rm -f "$out"; echo "nothing to migrate: all $rows_before row(s) already split out"; exit 0
    fi
    diff <(cut -f2-3,5-6 "$LOG") <(cut -f2-3,5-6 "$out") \
      | sed -n 's/^</  was:/p; s/^>/  now:/p' | head -60
    echo
    echo "$changed of $rows_before row(s) would change. Your log is UNCHANGED."
    echo "Read the above, then apply it yourself:"
    echo "  mv $out $LOG"
    ;;

  add)
    # Extend the set of movements this tool knows. The registry is plan.txt
    # itself, so what you add here is also what gets offered.
    #   gtg add "kettlebell swings x10 @ 50 lb"        -> the every-day pool
    #   gtg add "stairs, 2 flights" away               -> a named pool
    if [ -z "${2:-}" ]; then echo 'usage: gtg add "<movement>" [every|away|mon..sun]' >&2; exit 1; fi
    plan_add "$2" "${3:-every}"
    case $? in
      0) echo "added to ${3:-every}: $2"; echo; echo "today's pool is now:"; today_options "$where" | sed 's/^/  /' ;;
      2) echo "already there: $2" ;;
      *) exit 1 ;;
    esac
    ;;

  today)
    today=$(date '+%Y-%m-%d')
    if [ ! -s "$LOG" ]; then echo "nothing logged yet"; exit 0; fi
    # clean() on the name, not the raw field: rows written before weight and
    # duration had columns still carry them inside the name, and without this
    # a legacy "pull-ups x5" would render as "pull-ups x5 x5".
    #
    # Sorted, because the log is append-only: a set backdated with `gtg @8am`
    # sits at the END of the file describing the MORNING, and unsorted it
    # printed below sets that happened hours after it. ISO timestamps in the
    # first column make a plain lexicographic sort the right one.
    sort "$LOG" | awk -F'\t' -v d="$today" "$AWK_CLEAN$AWK_HUMAN"'
      index($1, d) == 1 {
        n++
        if ($3 ~ /^[0-9]+$/) reps += $3
        # A skipped set contributes no time. Totalling its duration counted a
        # miss as work done.
        if ($6 != "" && $3 != "skip") secs += $6
        printf "  %s  %s%s%s\n", substr($1, 12, 5), clean($2), human($3, $5, $6), \
               ($3 == "skip" ? "  (skipped)" : "")
      }
      END {
        if (n == 0) { print "  nothing yet today"; exit }
        # Whole minutes only, the same rule fmt_dur uses: 90s totalled as
        # "1 min" quietly lost half a minute.
        printf "\n%d set(s)%s%s today\n", n, (reps ? ", " reps " reps" : ""), \
               (secs ? ", " ((secs >= 60 && secs % 60 == 0) ? int(secs/60) " min" : secs "s") : "")
      }' 
    ;;

  week)
    if [ ! -s "$LOG" ]; then echo "nothing logged yet"; exit 0; fi
    # Seed the last 7 dates so days with zero sets still print. Silent gaps are
    # the whole point of looking.
    for i in 6 5 4 3 2 1 0; do date -v-"${i}"d '+%Y-%m-%d'; done >"$STATE_DIR/.week"
    awk -F'\t' '
      NR == FNR { order[++k] = $1; seen[$1] = 0; next }
      { d = substr($1, 1, 10); if (d in seen) { seen[d]++; if ($3 == "skip") sk[d]++ } }
      END {
        for (i = 1; i <= k; i++) {
          d = order[i]
          done_n = seen[d] - (d in sk ? sk[d] : 0)
          bar = ""
          for (j = 0; j < done_n; j++) bar = bar "#"
          printf "%s  %-14s %d\n", d, bar, done_n
        }
      }' "$STATE_DIR/.week" "$LOG"
    rm -f "$STATE_DIR/.week"
    ;;

  history)
    days=${2:-30}
    if [ ! -s "$LOG" ]; then echo "nothing logged yet"; exit 0; fi
    i=$(( days - 1 ))
    while [ "$i" -ge 0 ]; do date -v-"${i}"d '+%Y-%m-%d'; i=$(( i - 1 )); done >"$STATE_DIR/.range"
    awk -F'\t' '
      NR == FNR { order[++k] = $1; seen[$1] = 0; next }
      { d = substr($1, 1, 10)
        if (d in seen) { if ($3 == "skip") sk[d]++; else seen[d]++ } }
      END {
        total = 0; active = 0
        for (i = 1; i <= k; i++) {
          d = order[i]; n = seen[d]
          total += n; if (n > 0) active++
          bar = ""
          for (j = 0; j < n; j++) bar = bar "#"
          printf "%s  %-20s %s%s\n", d, bar, (n ? n : "."), \
                 (d in sk ? "  (" sk[d] " skipped)" : "")
        }
        printf "\n%d sets over %d days, %d day(s) active (%d%%)\n", \
               total, k, active, (k ? active * 100 / k : 0)
      }' "$STATE_DIR/.range" "$LOG"
    rm -f "$STATE_DIR/.range"
    ;;

  stats)
    if [ ! -s "$LOG" ]; then echo "nothing logged yet"; exit 0; fi
    # Grouped by normalized movement, so "push-ups x20" and "10 Pushups" are
    # one row. Shown under the latest spelling, counts stripped.
    awk -F'\t' "$AWK_KEY$AWK_CLEAN"'
      $3 != "skip" {
        k = key($2); c[k]++; if ($3 ~ /^[0-9]+$/) r[k] += $3
        if ($6 != "") d[k] += $6     # this branch is already non-skip
        # Latest by TIMESTAMP, file order breaking a tie -- backdating splits
        # the two apart, and pure file order would let a correction to an old
        # set redefine the weight shown as current. Same rule as
        # last_weight_for, tie-break included: a whole round lands inside one
        # second, so ">" alone would let its first set outrank its last.
        if ($5 != "" && $1 >= wseen[k]) { wseen[k] = $1; w[k] = $5 }
        name[k] = clean($2)
      }
      $3 == "skip" { k = key($2); sk[k]++; if (!(k in name)) name[k] = clean($2) }
      END {
        for (k in c) printf "%6d|%s|%d|%d|%s\n", c[k], name[k], r[k], d[k], w[k]
        for (k in sk) if (!(k in c)) printf "%6d|%s|%d|%d|%s\n", 0, name[k], 0, 0, ""
      }' "$LOG" | sort -rn | while IFS='|' read -r n e reps secs wt; do
        detail=""
        [ "${reps:-0}" -gt 0 ] && detail="$(printf '%5d reps' "$reps")"
        [ "${secs:-0}" -gt 0 ] && detail="$detail  $(fmt_dur "$secs")"
        [ -n "$wt" ] && detail="$detail  @ $(fmt_wt "$wt")"
        printf "  %-30s %3d sets  %s\n" "$e" "$n" "$detail"
      done
    echo
    awk -F'\t' 'END{print "  " NR " entries since " }' "$LOG" | tr -d '\n'
    head -1 "$LOG" | cut -c1-10
    ;;

  done)
    echo "logged: $(record_option "$line" "$where")  [$where]$(at_note)"
    ;;

  *)
    if printf '%s' "$1" | grep -qE '^[0-9]+$'; then
      echo "logged: $(record_option "$line" "$where" "$1")  [$where]$(at_note)"
    else
      # Anything else is whatever you actually did: gtg "chin-ups x8", or a
      # whole round separated by ";". An unknown movement is a question, not a
      # guess: nothing is recorded until you say to add it.
      out=$(record_batch "$1" "$where"); rc=$?
      case "$rc" in
        0) printf '%s\n' "$out" | sed 's/^/logged: /'
           echo "        [$where]$(at_note)" ;;
        3) exit 1 ;;   # record_batch has already named the movement and the fix
        *) echo "could not read that as a movement" >&2; exit 1 ;;
      esac
    fi
    ;;
esac
